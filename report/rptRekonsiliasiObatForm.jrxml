<?xml version="1.0" encoding="UTF-8"?>
<!-- Form cetak Rekonsiliasi Obat (RM 03-06A) - replika layout formulir fisik
     RSUD Demang Sepulau Raya (foto dari user). 1 halaman = 1 record
     rekonsiliasi_obat (1 no_rekonsiliasi = 1 tahap: Admisi/Transfer Antar
     Ruang/Pulang) - dataset utama (qry) = daftar obat
     (rekonsiliasi_obat_detail_obat) utk record itu, sisanya (identitas
     pasien, tahap, checkbox, apoteker) lewat parameter (1 nilai per
     print). Dibuat dgn JasperReports Library 6.8.0 (versi yg dipakai
     runtime app - lihat javac.classpath project.properties).
     Ukuran kertas F4/Folio (609x935pt) - samakan dgn konvensi semua form
     RM lain di app (mis. rptCetakPenilaianAwalKeperawatanIGD.jrxml).
     TTD Apoteker pakai QR-code tanda tangan elektronik - pola PERSIS sama
     dgn rptCetakPenilaianAwalKeperawatanIGD.jrxml / rptLembarTriaseSkala*.jrxml
     (parameter "finger" = teks berisi RS+nama petugas+ID SHA1 sidik jari
     (fallback ke NIP kalau blm rekam sidik jari)+tanggal, di-encode QR). -->
