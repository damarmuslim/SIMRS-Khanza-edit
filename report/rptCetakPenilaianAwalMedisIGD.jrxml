				<reportElement positionType="FixRelativeToTop" x="350" y="5" width="185" height="12" forecolor="#64748B"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="Tahoma" size="7" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["KATEGORI: " + ($F{kategori_pasien}!=null?$F{kategori_pasien}.toUpperCase():"UMUM") + " • Halaman " + $V{PAGE_NUMBER} + " dari "]]></textFieldExpression>
			</textField>
			<textField evaluationTime="Report">
				<reportElement positionType="FixRelativeToTop" x="536" y="5" width="33" height="12" forecolor="#64748B"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Tahoma" size="7" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA["" + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
</jasperReport>