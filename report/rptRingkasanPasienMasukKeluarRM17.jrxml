	<!--
	  Pemetaan pendidikan: kertas hanya menyediakan 6 kotak sementara kolom
	  pasien.pnd punya 14 nilai. TK, D1, D2 dan "-" TIDAK punya kotak padanan -
	  untuk nilai itu tidak ada kotak yang dicentang dan nilai aslinya dicetak di
	  ujung baris, supaya informasinya tidak hilang dan tidak ada klaim yang
	  keliru pada dokumen rekam medis. Data registrasi TIDAK diubah sama sekali.
	-->
	<!--
	  No. RM dipadankan ke enam kotak digit pada formulir fisik. Dinormalkan
	  lebih dulu jadi tepat 6 karakter (dipotong dari kanan kalau lebih panjang,
	  diberi spasi di kiri kalau lebih pendek) supaya tiap digit bisa ditaruh di
	  kotaknya masing-masing. Upaya pertama memakai satu textField dengan spasi
	  penyela GAGAL: lebar spasi tidak pernah pas dengan lebar kotak sehingga
	  digitnya bergeser - terlihat jelas saat cetakannya dirender.
	-->
	<variable name="rm6" class="java.lang.String">
		<variableExpression><![CDATA[$F{no_rkm_medis}==null?"      ":($F{no_rkm_medis}.length()>=6?$F{no_rkm_medis}.substring($F{no_rkm_medis}.length()-6):$F{no_rkm_medis}.padLeft(6))]]></variableExpression>
	</variable>

	<variable name="pnd_sarjana" class="java.lang.Boolean">
		<variableExpression><![CDATA[["D4","S1","S2","S3"].contains($F{pnd})]]></variableExpression>
	</variable>
	<variable name="pnd_slta" class="java.lang.Boolean">
		<variableExpression><![CDATA[["SMA","SLTA/SEDERAJAT"].contains($F{pnd})]]></variableExpression>
	</variable>
	<variable name="pnd_lain" class="java.lang.Boolean">
		<variableExpression><![CDATA[!["TS","SD","SMP","SMA","SLTA/SEDERAJAT","D3","D4","S1","S2","S3"].contains($F{pnd})]]></variableExpression>
	</variable>

