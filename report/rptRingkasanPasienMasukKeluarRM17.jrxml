<?xml version="1.0" encoding="UTF-8"?>
<!--
  RINGKASAN PASIEN MASUK KELUAR (RM 17-01) - RSUD Demang Sepulau Raya.
  Dua halaman: hal. 1 lembar ringkasan, hal. 2 SEBAB KEMATIAN.

  Tiga gotcha wajib proyek ini dipatuhi di SELURUH berkas:
    1. semua <textField> memakai isStretchWithOverflow="true"
    2. semua <staticText> tingginya >= 11 (di bawah itu teks tidak tampil)
    3. semua <band> memakai splitType="Prevent"

  Data: seluruh isinya datang dari <queryString> yang dijalankan pemanggil lewat
  Valid.MyReportqry (bukan queryString di berkas ini) - identitas & data
  registrasi di-JOIN, tidak disimpan ulang di tabel form.

  Halaman 2 dipisah dengan band <break> supaya SEBAB KEMATIAN selalu mulai di
  lembar baru: pada formulir fisik itu memang lembar terpisah.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="rptRingkasanPasienMasukKeluarRM17" language="groovy"
              pageWidth="609" pageHeight="935" columnWidth="569"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="c1a2b3d4-1701-0000-0000-000000000001">

