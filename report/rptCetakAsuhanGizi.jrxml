			<staticText><reportElement x="336" y="5" width="60" height="11" uuid="e1f2a3b4-6121-0001-0000-000000000006"/><textElement><font fontName="Tahoma" size="8"/></textElement><text><![CDATA[Nama]]></text></staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="398" y="5" width="167" height="11" uuid="e1f2a3b4-6121-0001-0000-000000000007"/><textElement><font fontName="Tahoma" size="8" isBold="true"/></textElement><!--
				  Query menyeleksi pasien.jk MENTAH, isinya 'L'/'P' - bukan hasil
				  if(...,'Laki-Laki','Perempuan') seperti di laporan lain. Upaya
				  pertama membandingkannya dengan "Laki-Laki" membuat SEMUA pasien
				  tercetak "P"; ketahuan saat cetakan dirender dengan data asli.
				  Dibuat menerima kedua bentuk supaya tidak rapuh terhadap query.
				-->
				<textFieldExpression><![CDATA[": "+($F{nm_pasien}==null?"":$F{nm_pasien})+"   "+(("L".equals($F{jk})||"Laki-Laki".equals($F{jk}))?"L":"P")]]></textFieldExpression></textField>
			<staticText><reportElement x="336" y="18" width="60" height="11" uuid="e1f2a3b4-6121-0001-0000-000000000008"/><textElement><font fontName="Tahoma" size="8"/></textElement><text><![CDATA[Tgl Lahir]]></text></staticText>
