				<textFieldExpression><![CDATA["Telp/Fax. "+($P{kontakrs}==null?"-":$P{kontakrs})+"   e-mail : "+($P{emailrs}==null?"-":$P{emailrs})]]></textFieldExpression>
			</textField>
			<line><reportElement x="362" y="0" width="1" height="64" uuid="d1e2f3a4-3200-0001-0000-000000000007"/></line>
