				<textElement><font fontName="Tahoma" size="6"/></textElement>
				<textFieldExpression><![CDATA[($P{alamatrs}==null?"":$P{alamatrs})+", "+($P{kotars}==null?"":$P{kotars})]]></textFieldExpression>
