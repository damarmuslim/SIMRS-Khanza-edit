				<textElement><font fontName="Tahoma" size="7" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[": "+($F{tgl_lahir}==null?"":$F{tgl_lahir})+" / "+($F{umurdaftar}==null?"":$F{umurdaftar})+" "+($F{sttsumur}==null?"":$F{sttsumur})]]></textFieldExpression>
			</textField>

			<staticText>
