				<textElement><font fontName="Tahoma" size="7" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[": "+($F{nm_pasien}==null?"":$F{nm_pasien})+"  "+(("L".equals($F{jk})||"LAKI-LAKI".equals($F{jk})||"Laki-Laki".equals($F{jk}))?"L":"P")]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="368" y="37" width="70" height="11" uuid="d1e2f3a4-3200-0001-0000-00000000000c"/>
				<textElement><font fontName="Tahoma" size="7"/></textElement>
