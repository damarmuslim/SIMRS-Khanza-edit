				<textElement><font fontName="Tahoma" size="7" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[": "+($F{no_rkm_medis}==null?"":$F{no_rkm_medis})]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="368" y="21" width="70" height="11" uuid="d1e2f3a4-3200-0001-0000-00000000000a"/>
				<textElement><font fontName="Tahoma" size="7"/></textElement>
				<text><![CDATA[Nama]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
