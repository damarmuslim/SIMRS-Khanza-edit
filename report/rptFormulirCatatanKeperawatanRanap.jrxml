<?xml version="1.0" encoding="UTF-8"?>
<!--
  CATATAN PERAWAT / BIDAN (RM 32) - RSUD Demang Sepulau Raya.

  DITULIS ULANG dari versi lama yang berjudul "CATATAN KEPERAWATAN", berukuran
  A4, dan hanya punya TIGA kolom (Tanggal & Jam, Uraian, Petugas). Lembar fisik
  RSUD berukuran F4, berjudul "CATATAN PERAWAT/BIDAN", berkode RM 32, dan punya
  LIMA kolom. Versi lama tetap tersimpan di riwayat git.

  Tiga gotcha wajib proyek ini dipatuhi di SELURUH berkas:
    1. semua textField memakai isStretchWithOverflow="true"
    2. semua staticText tingginya >= 11 (di bawah itu teks tidak tampil)
    3. semua band memakai splitType="Prevent"

  KOP DI pageHeader, BUKAN title
  Catatan perawat satu pasien bisa berlembar-lembar. Kalau kop diletakkan di
  band title, ia hanya tercetak di halaman pertama dan lembar kedua dst menjadi
  kertas tanpa identitas pasien - berbahaya untuk berkas rekam medis.

  RUANGAN dan NOMOR (bed) BUKAN KOLOM TABEL
  Keduanya dirakit di query cetak dari `kamar_inap` dengan mengambil baris
  TERAKHIR, sebab pasien yang pindah kamar punya beberapa baris. Aturan yang
  sama dipakai di RM 33.

  DUA KOLOM TANDA TANGAN
  - Tanda Tangan (perawat): QR PER BARIS. Isinya field `ttd_perawat` yang
    dirakit di SQL, bukan parameter - parameter nilainya sama untuk seluruh
    halaman, padahal tiap baris catatan bisa ditulis perawat yang berbeda.
  - Tanda Tangan Pasien/Keluarga: gambar hasil canvas tanda tangan di webapp
    `catatanperawatbidan`, diambil lewat URL http. onErrorType="Blank" membuat
    baris yang belum ditandatangani tercetak kosong, bukan gagal.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="rptFormulirCatatanKeperawatanRanap" language="groovy"
              pageWidth="609" pageHeight="935" columnWidth="569"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="d1e2f3a4-3200-0000-0000-000000000001">

	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<!-- Dikirim pemanggil; tidak dipakai di lembar ini, tapi tetap
	     dideklarasikan supaya pengisian parameter tidak ditolak. -->
	<parameter name="dpjp" class="java.lang.String"/>

	<queryString>
		<![CDATA[select * from catatan_keperawatan_ranap]]>
	</queryString>

	<field name="no_rkm_medis" class="java.lang.String"/>
	<field name="nm_pasien" class="java.lang.String"/>
	<field name="jk" class="java.lang.String"/>
	<field name="tgl_lahir" class="java.lang.String"/>
	<field name="umurdaftar" class="java.lang.String"/>
	<field name="sttsumur" class="java.lang.String"/>
	<field name="ruangan" class="java.lang.String"/>
	<field name="nomor_bed" class="java.lang.String"/>
	<field name="tanggal" class="java.lang.String"/>
	<field name="jam" class="java.lang.String"/>
	<field name="alkes_pengobatan_diet" class="java.lang.String"/>
	<field name="uraian" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="ttd_perawat" class="java.lang.String"/>
	<field name="ttd_pasien_url" class="java.lang.String"/>

	<pageHeader>
		<band height="142" splitType="Prevent">
