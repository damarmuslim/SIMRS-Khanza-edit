<?xml version="1.0" encoding="UTF-8"?>
<!-- Form cetak ASESMEN MEDIS RAWAT INAP (RM 20) - RSUD Demang Sepulau Raya.
     Replika lembar fisik 1 halaman, dipakai oleh rekammedis/RMAsesmenMedisRanap.java.

     DITULIS DARI NOL, bukan menambal rptCetakPenilaianAwalMedisRanap.jrxml
     (laporan form lama: A4, satu band raksasa, nol isStretchWithOverflow) -
     menambal file itu akan langsung menabrak ketiga gotcha di bawah.

     TIGA GOTCHA WAJIB proyek ini (semuanya sudah pernah memakan waktu, lihat
     PROGRESS.md RM 03-4/5/6 poin 16, 18 & 31):
       1. SEMUA <textField> WAJIB isStretchWithOverflow="true" - tanpa itu isinya
          bisa TIDAK TERENDER SAMA SEKALI (bukan cuma terpotong) di band Float.
       2. SEMUA <staticText> WAJIB height >= 11 untuk font size 8 - pada height 9
          teksnya konsisten tidak pernah muncul.
       3. SEMUA <band> WAJIB splitType="Prevent" - tanpa itu satu section bisa
          terbelah antar halaman (judul di halaman 1, isinya di halaman 2).
     Kotak centang digambar sebagai <rectangle> + "X" kondisional, BUKAN glyph
     Unicode (dibuktikan tidak pernah ter-render di pipeline PDF proyek ini).

     Kertas F4 609x935 - konvensi yang sudah dipakai belasan laporan lain di sini.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptAsesmenMedisRanapRM20" pageWidth="609" pageHeight="935" columnWidth="569" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b7c31a20-51de-4f0a-9a11-2c4e7d905a10">
	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<!-- Dua QR TERPISAH. Beda dari RM 03-4/5/6 yang memakai QR yang SAMA untuk
	     dua blok tanda tangan (di sana keduanya atestasi petugas yang sama);
	     di RM 20 penandatangannya benar-benar dua orang berbeda. -->
	<parameter name="finger_periksa" class="java.lang.String"/>
	<parameter name="finger_dpjp" class="java.lang.String"/>
	<queryString>
		<![CDATA[select asesmen_medis_ranap.*,pasien.no_rkm_medis,pasien.nm_pasien,pasien.tgl_lahir,if(pasien.jk='L','Laki-Laki','Perempuan') as jk,reg_periksa.tgl_registrasi,reg_periksa.jam_reg,dokterperiksa.nm_dokter as nm_dokter_periksa,dokterperiksa.no_ijn_praktek as ijin_periksa,dokterdpjp.nm_dokter as nm_dokter_dpjp,dokterdpjp.no_ijn_praktek as ijin_dpjp from asesmen_medis_ranap inner join reg_periksa on asesmen_medis_ranap.no_rawat=reg_periksa.no_rawat inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis left join dokter dokterperiksa on asesmen_medis_ranap.kd_dokter_periksa=dokterperiksa.kd_dokter left join dokter dokterdpjp on asesmen_medis_ranap.kd_dokter_dpjp=dokterdpjp.kd_dokter]]>
	</queryString>
	<field name="no_rawat" class="java.lang.String"/>
	<field name="tanggal" class="java.lang.String"/>
	<field name="keluhan_utama" class="java.lang.String"/>
	<field name="keluhan_tambahan" class="java.lang.String"/>
	<field name="alergi" class="java.lang.String"/>
