		<!-- ======= PENGKAJIAN MEDIS / II. PEMERIKSAAN MEDIS + DIAGNOSA + RENCANA ======= -->
		<band height="215" splitType="Prevent">
			<staticText>
				<reportElement x="0" y="4" width="200" height="12" uuid="b7c31a20-0003-4000-8000-000000000001"/>
				<textElement><font fontName="Tahoma" size="9" isBold="true"/></textElement>
				<text><![CDATA[PENGKAJIAN MEDIS]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="18" width="200" height="12" uuid="b7c31a20-0003-4000-8000-000000000002"/>
				<textElement><font fontName="Tahoma" size="9" isBold="true"/></textElement>
				<text><![CDATA[II. PEMERIKSAAN MEDIS]]></text>
			</staticText>
			<staticText>
				<reportElement x="10" y="33" width="90" height="11" uuid="b7c31a20-0003-4000-8000-000000000003"/>
				<textElement><font fontName="Tahoma" size="8"/></textElement>
				<text><![CDATA[Keadaan Umum]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="102" y="33" width="230" height="11" uuid="b7c31a20-0003-4000-8000-000000000004"/>
				<textElement><font fontName="Tahoma" size="8"/></textElement>
				<textFieldExpression><![CDATA[": "+($F{keadaan_umum}==null?"-":$F{keadaan_umum})]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="10" y="46" width="90" height="11" uuid="b7c31a20-0003-4000-8000-000000000005"/>
				<textElement><font fontName="Tahoma" size="8"/></textElement>
				<text><![CDATA[Kesadaran Mental]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="102" y="46" width="120" height="11" uuid="b7c31a20-0003-4000-8000-000000000006"/>
				<textElement><font fontName="Tahoma" size="8"/></textElement>
				<textFieldExpression><![CDATA[": "+($F{kesadaran_mental}==null?"-":$F{kesadaran_mental})]]></textFieldExpression>
			</textField>
			<!-- Kertas menulis "GSC" (typo lazim dari GCS) dengan urutan E-M-V.
			     Teks & urutan sengaja mengikuti kertas apa adanya. -->
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="228" y="46" width="110" height="11" uuid="b7c31a20-0003-4000-8000-000000000007"/>
				<textElement><font fontName="Tahoma" size="8"/></textElement>
				<textFieldExpression><![CDATA["GSC : E "+($F{gcs_e}==null?"":$F{gcs_e})+"  M "+($F{gcs_m}==null?"":$F{gcs_m})+"  V "+($F{gcs_v}==null?"":$F{gcs_v})]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="10" y="59" width="330" height="11" uuid="b7c31a20-0003-4000-8000-000000000008"/>
				<textElement><font fontName="Tahoma" size="8"/></textElement>
				<textFieldExpression><![CDATA["Tensi : "+($F{td_sistol}==null?"":$F{td_sistol})+"/"+($F{td_diastol}==null?"":$F{td_diastol})+" mmHg, Nadi: "+($F{nadi}==null?"":$F{nadi})+"/mnt.  RR: "+($F{rr}==null?"":$F{rr})+"/mnt,  T: "+($F{suhu}==null?"":$F{suhu})+" °C"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="10" y="72" width="150" height="11" uuid="b7c31a20-0003-4000-8000-000000000009"/>
				<textElement><font fontName="Tahoma" size="8"/></textElement>
				<textFieldExpression><![CDATA["TB : "+($F{tb}==null?"":$F{tb})+" cm"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="10" y="85" width="150" height="11" uuid="b7c31a20-0003-4000-8000-000000000010"/>
				<textElement><font fontName="Tahoma" size="8"/></textElement>
				<textFieldExpression><![CDATA["BB : "+($F{bb}==null?"":$F{bb})+" kg"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="165" y="72" width="175" height="11" uuid="b7c31a20-0003-4000-8000-000000000011"/>
				<textElement><font fontName="Tahoma" size="8"/></textElement>
				<textFieldExpression><![CDATA[($F{imt}==null||$F{imt}.isEmpty())?"":"IMT : "+$F{imt}]]></textFieldExpression>
			</textField>

