				<text><![CDATA[PEMERINTAH KABUPATEN LAMPUNG TENGAH]]></text>
			</staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="62" y="16" width="296" height="15" uuid="d1e2f3a4-2701-0001-0000-000000000004"/>
				<textElement><font fontName="Tahoma" size="11" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$P{namars}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="62" y="33" width="296" height="11" uuid="d1e2f3a4-2701-0001-0000-000000000005"/>
				<textElement><font fontName="Tahoma" size="6"/></textElement>
				<textFieldExpression><![CDATA[($P{alamatrs}==null?"":$P{alamatrs})+", "+($P{kotars}==null?"":$P{kotars})]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement x="62" y="45" width="296" height="11" uuid="d1e2f3a4-2701-0001-0000-000000000006"/>
				<textElement><font fontName="Tahoma" size="6"/></textElement>
				<textFieldExpression><![CDATA["Telp/Fax. "+($P{kontakrs}==null?"-":$P{kontakrs})]]></textFieldExpression>
			</textField>
			<line><reportElement x="362" y="0" width="1" height="64" uuid="d1e2f3a4-2701-0001-0000-000000000007"/></line>
			<staticText><reportElement x="368" y="8" width="66" height="11" uuid="d1e2f3a4-2701-0001-0000-000000000008"/><textElement><font fontName="Tahoma" size="8"/></textElement><text><![CDATA[No. RM]]></text></staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="436" y="8" width="129" height="11" uuid="d1e2f3a4-2701-0001-0000-000000000009"/><textElement><font fontName="Tahoma" size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[": "+($P{no_rkm_medis}==null?"":$P{no_rkm_medis})]]></textFieldExpression></textField>
			<staticText><reportElement x="368" y="26" width="66" height="11" uuid="d1e2f3a4-2701-0001-0000-00000000000a"/><textElement><font fontName="Tahoma" size="8"/></textElement><text><![CDATA[Nama]]></text></staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="436" y="26" width="129" height="11" uuid="d1e2f3a4-2701-0001-0000-00000000000b"/><textElement><font fontName="Tahoma" size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[": "+($P{nm_pasien}==null?"":$P{nm_pasien})+"  "+(("L".equals($P{jk})||"Laki-Laki".equals($P{jk}))?"L":"P")]]></textFieldExpression></textField>
			<staticText><reportElement x="368" y="44" width="66" height="11" uuid="d1e2f3a4-2701-0001-0000-00000000000c"/><textElement><font fontName="Tahoma" size="8"/></textElement><text><![CDATA[Tgl Lahir/Umur]]></text></staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="436" y="44" width="129" height="11" uuid="d1e2f3a4-2701-0001-0000-00000000000d"/><textElement><font fontName="Tahoma" size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[": "+($P{tgl_lahir}==null?"":$P{tgl_lahir})+" / "+($P{umur}==null?"":$P{umur})]]></textFieldExpression></textField>

			<staticText>
				<reportElement x="490" y="66" width="75" height="13" uuid="d1e2f3a4-2701-0001-0000-00000000000e"/>
				<textElement textAlignment="Right"><font fontName="Tahoma" size="10" isBold="true"/></textElement>
				<text><![CDATA[RM 27-1]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="82" width="569" height="15" uuid="d1e2f3a4-2701-0001-0000-00000000000f"/>
				<textElement textAlignment="Center"><font fontName="Tahoma" size="11" isBold="true"/></textElement>
				<text><![CDATA[CATATAN PERKEMBANGAN PASIEN TERINTEGRASI / CPPT]]></text>
			</staticText>
		</band>
	</pageHeader>

