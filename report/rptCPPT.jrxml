<?xml version="1.0" encoding="UTF-8"?>
<!--
  CATATAN PERKEMBANGAN PASIEN TERINTEGRASI / CPPT (RM 27-1)
  RSUD Demang Sepulau Raya. Satu lembar per KUNJUNGAN (satu no_rawat).

  Tiga gotcha wajib proyek ini dipatuhi di SELURUH berkas:
    1. semua textField memakai isStretchWithOverflow="true"
    2. semua staticText tingginya >= 11 (di bawah itu teks tidak tampil)
    3. semua band memakai splitType="Prevent"

  TIDAK ADA TABEL BARU - DIRAKIT DARI TIGA SUMBER YANG SUDAH ADA
  Kertasnya menyebut "ditulis dengan format SOAP atau ADIME", dan sistem
  kebetulan punya persis keduanya sebagai tabel terpisah:
      pemeriksaan_ranap   -> SOAP rawat inap
      pemeriksaan_ralan   -> SOAP rawat jalan
      catatan_adime_gizi  -> ADIME gizi
  Ketiganya digabung dengan UNION ALL lalu diurutkan menurut waktu, sehingga
  catatan semua profesi tampil berselang-seling secara kronologis - itulah
  yang membuat CPPT "terintegrasi".

  BERLAKU UNTUK RALAN DAN RANAP - keputusan user.
  Petunjuknya ada di kertas itu sendiri: CPPT TIDAK punya isian Ruangan
  maupun Tanggal Masuk, padahal RM 32 dan RM 33 yang khusus rawat inap
  keduanya punya. Struktur pemeriksaan_ranap dan pemeriksaan_ralan pun
  identik kolom demi kolom.

  KOLOM `nip` BISA BERISI DUA JENIS KODE
  Pada data nyata, nip di tabel pemeriksaan berisi NIP petugas
  (mis. 12/09/1988/001 -> ANJASMARA) ATAU kode dokter (mis. D0000003 ->
  dr. Qotrunnada). Karena itu profesi dicari ke DUA arah: lewat
  petugas->jabatan, dan kalau tidak ketemu lewat dokter->spesialis. Kalau
  hanya join ke petugas, SELURUH catatan dokter akan kehilangan kolom
  Profesi - padahal justru itu inti CPPT.

  VERIFIKASI DPJP SENGAJA DICETAK KOSONG
  Kertasnya berbunyi "Bubuhkan Stempel, Nama Paraf, Tgl, Jam" - kolom itu
  memang dirancang untuk stempel dan paraf BASAH. Tidak ada datanya di
  sistem, dan tidak dikarang.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="rptCPPT" language="groovy"
              pageWidth="609" pageHeight="935" columnWidth="569"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail"
              uuid="d1e2f3a4-2701-0000-0000-000000000001">

	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="norawat" class="java.lang.String"/>
	<!-- Identitas pasien lewat parameter, bukan field: nilainya sama untuk
	     seluruh halaman, dan lembar tetap tercetak utuh walau belum ada satu
	     pun catatan (whenNoDataType AllSectionsNoDetail). -->
	<parameter name="no_rkm_medis" class="java.lang.String"/>
	<parameter name="nm_pasien" class="java.lang.String"/>
	<parameter name="jk" class="java.lang.String"/>
	<parameter name="tgl_lahir" class="java.lang.String"/>
	<parameter name="umur" class="java.lang.String"/>

	<queryString>
		<![CDATA[select x.tgl, x.jam, x.profesi, x.nm_pengisi, x.analisis, x.instruksi from (

  select pr.tgl_perawatan as tgl, pr.jam_rawat as jam,
         ifnull(jabatan.nm_jbtn, if(dokter.kd_dokter is not null,
                ifnull(nullif(spesialis.nm_sps,''),'DOKTER'), '')) as profesi,
         ifnull(petugas.nama, ifnull(dokter.nm_dokter,'')) as nm_pengisi,
         concat_ws('\n',
             concat('S : ', ifnull(nullif(pr.keluhan,''),'-')),
             concat('O : ', ifnull(nullif(pr.pemeriksaan,''),'-')),
             nullif(concat_ws(' ',
                 nullif(concat('TD ',pr.tensi),'TD '),
                 nullif(concat('N ',pr.nadi),'N '),
                 nullif(concat('Suhu ',pr.suhu_tubuh),'Suhu '),
                 nullif(concat('RR ',pr.respirasi),'RR '),
                 nullif(concat('SpO2 ',pr.spo2),'SpO2 ')),''),
             concat('A : ', ifnull(nullif(pr.penilaian,''),'-')),
             nullif(concat('Evaluasi : ', nullif(pr.evaluasi,'')),''),
             concat('P : ', ifnull(nullif(pr.rtl,''),'-'))) as analisis,
         ifnull(pr.instruksi,'') as instruksi
  from pemeriksaan_ranap pr
  left join petugas   on pr.nip = petugas.nip
  left join jabatan   on petugas.kd_jbtn = jabatan.kd_jbtn
  left join dokter    on pr.nip = dokter.kd_dokter
  left join spesialis on dokter.kd_sps = spesialis.kd_sps
  where pr.no_rawat = $P{norawat}

  union all

  select pr.tgl_perawatan as tgl, pr.jam_rawat as jam,
         ifnull(jabatan.nm_jbtn, if(dokter.kd_dokter is not null,
                ifnull(nullif(spesialis.nm_sps,''),'DOKTER'), '')) as profesi,
         ifnull(petugas.nama, ifnull(dokter.nm_dokter,'')) as nm_pengisi,
         concat_ws('\n',
             concat('S : ', ifnull(nullif(pr.keluhan,''),'-')),
             concat('O : ', ifnull(nullif(pr.pemeriksaan,''),'-')),
             nullif(concat_ws(' ',
                 nullif(concat('TD ',pr.tensi),'TD '),
                 nullif(concat('N ',pr.nadi),'N '),
                 nullif(concat('Suhu ',pr.suhu_tubuh),'Suhu '),
                 nullif(concat('RR ',pr.respirasi),'RR '),
                 nullif(concat('SpO2 ',pr.spo2),'SpO2 ')),''),
             concat('A : ', ifnull(nullif(pr.penilaian,''),'-')),
             nullif(concat('Evaluasi : ', nullif(pr.evaluasi,'')),''),
             concat('P : ', ifnull(nullif(pr.rtl,''),'-'))) as analisis,
         ifnull(pr.instruksi,'') as instruksi
  from pemeriksaan_ralan pr
  left join petugas   on pr.nip = petugas.nip
  left join jabatan   on petugas.kd_jbtn = jabatan.kd_jbtn
  left join dokter    on pr.nip = dokter.kd_dokter
  left join spesialis on dokter.kd_sps = spesialis.kd_sps
  where pr.no_rawat = $P{norawat}

  union all

  select date(cag.tanggal) as tgl, time(cag.tanggal) as jam,
         ifnull(nullif(jabatan.nm_jbtn,''),'AHLI GIZI') as profesi,
         ifnull(petugas.nama,'') as nm_pengisi,
         concat_ws('\n',
             concat('A : ', ifnull(nullif(cag.asesmen,''),'-')),
             concat('D : ', ifnull(nullif(cag.diagnosis,''),'-')),
             concat('I : ', ifnull(nullif(cag.intervensi,''),'-')),
             concat('M : ', ifnull(nullif(cag.monitoring,''),'-')),
             concat('E : ', ifnull(nullif(cag.evaluasi,''),'-'))) as analisis,
         ifnull(cag.instruksi,'') as instruksi
  from catatan_adime_gizi cag
  left join petugas on cag.nip = petugas.nip
  left join jabatan on petugas.kd_jbtn = jabatan.kd_jbtn
  where cag.no_rawat = $P{norawat}

) x order by x.tgl, x.jam]]>
	</queryString>

	<field name="tgl" class="java.lang.String"/>
	<field name="jam" class="java.lang.String"/>
	<field name="profesi" class="java.lang.String"/>
	<field name="nm_pengisi" class="java.lang.String"/>
	<field name="analisis" class="java.lang.String"/>
	<field name="instruksi" class="java.lang.String"/>

