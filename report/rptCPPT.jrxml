			<staticText><reportElement x="2" y="37" width="54" height="11" uuid="d1e2f3a4-2701-0002-0000-000000000007"/><textElement textAlignment="Center"><font fontName="Tahoma" size="8" isBold="true"/></textElement><text><![CDATA[JAM]]></text></staticText>

			<staticText><reportElement x="62" y="26" width="56" height="11" uuid="d1e2f3a4-2701-0002-0000-000000000008"/><textElement textAlignment="Center"><font fontName="Tahoma" size="8" isBold="true"/></textElement><text><![CDATA[PROFESI]]></text></staticText>
			<staticText><reportElement x="62" y="37" width="56" height="11" uuid="d1e2f3a4-2701-0002-0000-000000000009"/><textElement textAlignment="Center"><font fontName="Tahoma" size="8" isBold="true"/></textElement><text><![CDATA[BAGIAN]]></text></staticText>

			<staticText><reportElement x="124" y="4" width="192" height="11" uuid="d1e2f3a4-2701-0002-0000-00000000000a"/><textElement textAlignment="Center"><font fontName="Tahoma" size="8" isBold="true"/></textElement><text><![CDATA[HASIL PEMERIKSAAN ANALISIS]]></text></staticText>
			<staticText><reportElement x="124" y="16" width="192" height="56" uuid="d1e2f3a4-2701-0002-0000-00000000000b"/><textElement textAlignment="Center"><font fontName="Tahoma" size="6"/></textElement><text><![CDATA[(ditulis dengan format SOAP atau ADIME disertai dengan target yang terukur, Evaluasi hasil tata laksana dituliskan dalam assesmen (Harap Bubuhkan Stempel, Nama, dan Paraf pada akhir catatan)]]></text></staticText>

			<staticText><reportElement x="324" y="10" width="152" height="11" uuid="d1e2f3a4-2701-0002-0000-00000000000c"/><textElement textAlignment="Center"><font fontName="Tahoma" size="8" isBold="true"/></textElement><text><![CDATA[INSTRUSI TENAGA]]></text></staticText>
