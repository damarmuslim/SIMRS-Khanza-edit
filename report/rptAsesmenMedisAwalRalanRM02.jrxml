			<staticText><reportElement x="3" y="42" width="14" height="11" uuid="d1e2f3a4-0201-0002-0000-00000000000a"/><textElement><font fontName="Tahoma" size="6"/></textElement><text><![CDATA[3]]></text></staticText>
