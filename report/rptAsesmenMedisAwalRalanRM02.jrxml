<?xml version="1.0" encoding="UTF-8"?>
<!--
  ASESMEN MEDIS AWAL RAWAT JALAN (RM 02-1) - RSUD Demang Sepulau Raya.
  Satu lembar per kunjungan rawat jalan.

  Tiga gotcha wajib proyek ini dipatuhi di SELURUH berkas:
    1. semua textField memakai isStretchWithOverflow="true"
    2. semua staticText tingginya >= 11 (di bawah itu teks tidak tampil)
    3. semua band memakai splitType="Prevent"

  TINGKAT RISIKO JATUH DIHITUNG DI EKSPRESI, TIDAK DIAMBIL DARI KOLOM
  Kertasnya berbunyi "Tidak beresiko bila tidak ditemukan a dan b; Beresiko
  bila ditemukan salah satu antara a dan b". Itu turunan murni dari dua
  jawaban, jadi tidak ada kolomnya di database - menyimpannya berarti
  menyimpan sesuatu yang bisa desinkron dari dasarnya.

  Query di dalam berkas ini dengan $P{norawat}, dipanggil lewat
  Valid.MyReport - identitas pasien ikut di-JOIN, tidak disalin ke tabel form.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="rptAsesmenMedisAwalRalanRM02" language="groovy"
              pageWidth="609" pageHeight="935" columnWidth="569"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="d1e2f3a4-0201-0000-0000-000000000001">

	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="finger" class="java.lang.String"/>
	<parameter name="norawat" class="java.lang.String"/>

	<queryString>
		<![CDATA[select pasien.no_rkm_medis,pasien.nm_pasien,
       date_format(pasien.tgl_lahir,'%d-%m-%Y') as tgl_lahir,
       if(pasien.jk='L','Laki-Laki','Perempuan') as jk,
       concat(reg_periksa.umurdaftar,' ',reg_periksa.sttsumur) as umur,
       date_format(reg_periksa.tgl_registrasi,'%d-%m-%Y') as tgl_masuk,
       date_format(a.tanggal,'%d-%m-%Y') as tgl_asesmen,
       ifnull(a.keyakinan_nilai,'') as keyakinan_nilai,
       ifnull(a.budaya,'') as budaya,
       ifnull(a.kemampuan_membaca,'') as kemampuan_membaca,
       ifnull(a.tingkat_pendidikan,'') as tingkat_pendidikan,
       ifnull(a.ket_tingkat_pendidikan,'') as ket_tingkat_pendidikan,
       ifnull(a.bahasa_indonesia,'') as bahasa_indonesia,
       ifnull(a.bahasa_inggris,'') as bahasa_inggris,
       ifnull(a.bahasa_daerah1,'') as bahasa_daerah1,
       ifnull(a.kemampuan_daerah1,'') as kemampuan_daerah1,
       ifnull(a.bahasa_daerah2,'') as bahasa_daerah2,
       ifnull(a.kemampuan_daerah2,'') as kemampuan_daerah2,
       ifnull(a.penerjemah,'') as penerjemah,
       ifnull(a.ket_penerjemah,'') as ket_penerjemah,
       ifnull(a.hambatan_emosional,'') as hambatan_emosional,
       ifnull(a.ket_hambatan_emosional,'') as ket_hambatan_emosional,
       ifnull(a.hambatan_motivasi,'') as hambatan_motivasi,
       ifnull(a.ket_hambatan_motivasi,'') as ket_hambatan_motivasi,
       ifnull(a.keterbatasan_fisik,'') as keterbatasan_fisik,
       ifnull(a.ket_keterbatasan_fisik,'') as ket_keterbatasan_fisik,
       ifnull(a.keterbatasan_kognitif,'') as keterbatasan_kognitif,
       ifnull(a.ket_keterbatasan_kognitif,'') as ket_keterbatasan_kognitif,
       ifnull(a.kesediaan_menerima,'') as kesediaan_menerima,
       ifnull(a.klinik,'') as klinik,
       ifnull(a.ket_klinik,'') as ket_klinik,
       ifnull(a.rpd_ada,'') as rpd_ada, ifnull(a.rpd_dm,'') as rpd_dm,
       ifnull(a.rpd_jantung,'') as rpd_jantung, ifnull(a.rpd_hipertensi,'') as rpd_hipertensi,
       ifnull(a.rpd_lain1,'') as rpd_lain1, ifnull(a.rpd_lain2,'') as rpd_lain2,
       ifnull(a.alergi_ada,'') as alergi_ada,
       ifnull(a.alergi1,'') as alergi1, ifnull(a.alergi2,'') as alergi2,
       ifnull(a.alergi3,'') as alergi3, ifnull(a.alergi4,'') as alergi4,
       ifnull(a.rpk_ada,'') as rpk_ada, ifnull(a.rpk_dm,'') as rpk_dm,
       ifnull(a.rpk_jantung,'') as rpk_jantung, ifnull(a.rpk_hipertensi,'') as rpk_hipertensi,
       ifnull(a.rpk_lain1,'') as rpk_lain1, ifnull(a.rpk_lain2,'') as rpk_lain2,
       ifnull(a.jatuh_cara_berjalan,'') as jatuh_cara_berjalan,
       ifnull(a.jatuh_menopang,'') as jatuh_menopang,
       ifnull(a.keluhan_utama,'') as keluhan_utama, ifnull(a.rps,'') as rps,
       ifnull(a.keadaan_umum,'') as keadaan_umum,
       ifnull(a.nadi,'') as nadi, ifnull(a.nafas,'') as nafas, ifnull(a.suhu,'') as suhu,
       ifnull(a.tensi_sistolik,'') as tensi_sistolik, ifnull(a.tensi_diastolik,'') as tensi_diastolik,
       ifnull(a.bb,'') as bb, ifnull(a.tinggi,'') as tinggi,
       ifnull(a.status_gizi,'') as status_gizi,
       ifnull(a.diagnosis1,'') as diagnosis1, ifnull(a.diagnosis2,'') as diagnosis2,
       ifnull(a.rencana_terapi,'') as rencana_terapi,
       ifnull(dokter.nm_dokter,'') as nm_dokter
from asesmen_medis_awal_ralan a
inner join reg_periksa on a.no_rawat=reg_periksa.no_rawat
inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis
left join dokter on a.kd_dokter=dokter.kd_dokter
where a.no_rawat=$P{norawat}]]>
	</queryString>

