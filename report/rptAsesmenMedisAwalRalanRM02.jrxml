	<field name="rpk_hipertensi" class="java.lang.String"/>
	<field name="rpk_lain1" class="java.lang.String"/>
	<field name="rpk_lain2" class="java.lang.String"/>
	<field name="jatuh_cara_berjalan" class="java.lang.String"/>
	<field name="jatuh_menopang" class="java.lang.String"/>
	<field name="keluhan_utama" class="java.lang.String"/>
	<field name="rps" class="java.lang.String"/>
	<field name="keadaan_umum" class="java.lang.String"/>
