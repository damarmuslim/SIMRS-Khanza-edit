			<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="142" y="55" width="423" height="11" uuid="d1e2f3a4-0201-0002-0000-00000000000e"/><textElement><font fontName="Tahoma" size="6" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{tingkat_pendidikan}+(($F{ket_tingkat_pendidikan}.trim().length()==0)?"":"  ("+$F{ket_tingkat_pendidikan}+")")]]></textFieldExpression></textField>

