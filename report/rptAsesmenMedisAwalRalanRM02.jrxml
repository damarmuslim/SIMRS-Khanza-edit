			<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="142" y="42" width="423" height="11" uuid="d1e2f3a4-0201-0002-0000-00000000000c"/><textElement><font fontName="Tahoma" size="6" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{kemampuan_membaca}]]></textFieldExpression></textField>

