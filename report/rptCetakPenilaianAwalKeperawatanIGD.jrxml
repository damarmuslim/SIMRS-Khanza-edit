				<textFieldExpression><![CDATA[($F{mst_kesimpulan}!=null && !$F{mst_kesimpulan}.isEmpty() ? $F{mst_kesimpulan}.toUpperCase() : (($F{mst_total_skor}!=null&&$F{mst_total_skor}.matches("\\d+")?Integer.parseInt($F{mst_total_skor}):0)>=2?"RISIKO":"TIDAK BERISIKO"))]]></textFieldExpression>
