			<staticText>
				<reportElement positionType="Float" x="10" y="50" width="390" height="12" forecolor="#0F172A"></reportElement>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Tahoma" size="8" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[1. Apakah pasien mengalami penurunan BB yang tidak diinginkan dalam 6 bulan terakhir?]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="10" y="63" width="390" height="18" forecolor="#475569"></reportElement>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Tahoma" size="6"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[a. Tidak ada penurunan BB (0) | b. Tidak yakin / baju terasa longgar (2) | c. Jika Ya: 1-5 kg (1) • 6-10 kg (2) • 11-15 kg (3) • >15 kg (4) • Tidak tahu (2)]]></text>
			</staticText>
			<textField>
				<reportElement positionType="Float" x="410" y="56" width="92" height="14" forecolor="#0F172A"></reportElement>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Tahoma" size="8" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[($F{mst_penurunan_bb}!=null&&!$F{mst_penurunan_bb}.isEmpty()?$F{mst_penurunan_bb}.replace("–","-").replace("â€“","-")+($F{mst_penurunan_bb_kg}!=null&&!$F{mst_penurunan_bb_kg}.isEmpty()?" ("+$F{mst_penurunan_bb_kg}+")":""):"—")]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement positionType="Float" x="508" y="56" width="50" height="14" forecolor="#0F172A"></reportElement>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="8" isBold="true"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[($F{mst_penurunan_bb}!=null&&($F{mst_penurunan_bb}.contains("1-5")||$F{mst_penurunan_bb}.contains("1–5"))?"1":$F{mst_penurunan_bb}!=null&&($F{mst_penurunan_bb}.contains("6-10")||$F{mst_penurunan_bb}.contains("6–10")||$F{mst_penurunan_bb}.contains("6")||$F{mst_penurunan_bb}.contains("Tidak yakin"))?"2":$F{mst_penurunan_bb}!=null&&($F{mst_penurunan_bb}.contains("11-15")||$F{mst_penurunan_bb}.contains("11–15"))?"3":$F{mst_penurunan_bb}!=null&&$F{mst_penurunan_bb}.contains(">15")?"4":"0")]]></textFieldExpression>
			</textField>
			<line>
