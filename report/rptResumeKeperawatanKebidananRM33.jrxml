	<parameter name="finger_petugas" class="java.lang.String"/>

	<queryString>
		<![CDATA[select * from resume_keperawatan_ranap]]>
	</queryString>

	<field name="no_rkm_medis" class="java.lang.String"/>
	<field name="nm_pasien" class="java.lang.String"/>
	<field name="tgl_lahir" class="java.lang.String"/>
	<field name="jk" class="java.lang.String"/>
	<field name="umur" class="java.lang.String"/>
	<field name="tgl_resume" class="java.lang.String"/>
	<field name="nm_petugas" class="java.lang.String"/>

	<!-- Dirakit di query cetak dari kamar_inap, bukan kolom tabel form ini. -->
