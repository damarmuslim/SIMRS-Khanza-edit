<?xml version="1.0" encoding="UTF-8"?>
<!--
  ASESMEN & PERENCANAAN PENDIDIKAN PASIEN (RM 21) - RSUD Demang Sepulau Raya.
  Diisi oleh Perawat / Bidan, khusus pasien rawat inap. Satu halaman.

  Tiga gotcha wajib proyek ini dipatuhi di SELURUH berkas:
    1. semua <textField> memakai isStretchWithOverflow="true"
    2. semua <staticText> tingginya >= 11 (di bawah itu teks tidak tampil)
    3. semua <band> memakai splitType="Prevent"

  CATATAN PENTING SOAL KOLOM "SASARAN"
  Di form input, Sasaran adalah DROPDOWN (satu pilihan) - keputusan user, karena
  dropdown mencegah pilihan yang saling bertentangan tercentang bersamaan
  ("Pasien" dan "Pasien & Keluarga" sekaligus). Di CETAKAN, nilainya
  diterjemahkan kembali menjadi tiga kotak centang persis seperti formulir
  fisik. Jadi tampilan kertas tetap sama, tapi datanya tidak bisa kontradiktif.

  Kolom "Pemberian Edukasi" berisi teks TETAP (Dokter/Farmasi/Perawat-Bidan/
  Ahli Gizi/Terapis) - di formulir fisik memang sudah tercetak, tidak diambil
  dari database.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="rptAsesmenPendidikanPasienRM21" language="groovy"
              pageWidth="609" pageHeight="935" columnWidth="569"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="d1e2f3a4-2100-0000-0000-000000000001">

	<parameter name="namars" class="java.lang.String"/>
