	<field name="tgl_asesmen" class="java.lang.String"/>
	<field name="jam" class="java.lang.String"/>
	<field name="nm_petugas" class="java.lang.String"/>
	<!--
	  `nip` sengaja TIDAK dideklarasikan: formulir fisik hanya meminta "Nama
	  Jelas dan tanda tangan" tanpa baris NIP. NIP-nya tetap ikut ter-encode di
	  QR lewat parameter finger_petugas.
	-->

