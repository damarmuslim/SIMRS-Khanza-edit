	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<!-- Atestasi Perawat/Bidan yang di-encode jadi QR di blok tanda tangan. -->
	<parameter name="finger_petugas" class="java.lang.String"/>

	<queryString>
		<![CDATA[select * from asesmen_pendidikan_pasien_ranap]]>
	</queryString>

