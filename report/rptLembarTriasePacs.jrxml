			<staticText><reportElement x="120" y="120" width="6" height="14"/><textElement verticalAlignment="Middle"><font fontName="Tahoma" size="7.5"/></textElement><text><![CDATA[:]]></text></staticText>
			<!-- Infus -->
			<rectangle><reportElement mode="Transparent" x="130" y="123" width="8" height="8"/><graphicElement><pen lineWidth="0.5"/></graphicElement></rectangle>
