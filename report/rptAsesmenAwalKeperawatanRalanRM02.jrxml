<?xml version="1.0" encoding="UTF-8"?>
<!--
  ASESMEN AWAL KEPERAWATAN DI INSTALASI RAWAT JALAN (RM 02-2 / RM 02-3)
  RSUD Demang Sepulau Raya. Satu lembar per kunjungan rawat jalan.

  Tiga gotcha wajib proyek ini dipatuhi di SELURUH berkas:
    1. semua textField memakai isStretchWithOverflow="true"
    2. semua staticText tingginya >= 11 (di bawah itu teks tidak tampil)
    3. semua band memakai splitType="Prevent"
  Elemen rectangle di band yang isinya bisa memanjang memakai
  stretchType="RelativeToBandHeight", kalau tidak teks panjang meluber keluar
  kotaknya sementara garisnya tetap (bug yang pernah kena di RM 01).

  DUA BLOK BERSYARAT, SAMA SEPERTI DI FORM
  Band BALITA dan band KESEHATAN REPRODUKSI memakai printWhenExpression.
  Lembar pasien dewasa laki laki tidak memuat kotak balita kosong, persis
  seperti formnya tidak menampilkan isiannya. Aturan umurnya sengaja
  ditempatkan DI QUERY (alias balita) supaya layar dan kertas memakai satu
  rumus yang sama, bukan dua rumus yang bisa berbeda diam diam.
  Pengaman yang sama juga dibawa ke sini: kalau kolomnya SUDAH ada isinya
  (alias isi_balita / isi_repro tidak kosong), banda tetap dicetak walau
  syarat umur atau jenis kelamin tidak lagi terpenuhi.

  SATU KOLOM PER REGIO
  Pemeriksaan fisik disimpan satu teks per regio berisi temuan yang dicentang.
  Karena itu di sini tiap regio cukup satu textField, bukan dua puluh kotak.

  Query di dalam berkas ini dengan $P{norawat}, dipanggil lewat
  Valid.MyReport, mengikuti tetangganya di RM 02-1. Identitas pasien ikut
  di-JOIN, tidak disalin ke tabel form.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="rptAsesmenAwalKeperawatanRalanRM02" language="groovy"
              pageWidth="609" pageHeight="935" columnWidth="569"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="d1e2f3a4-0202-0000-0000-000000000001">

	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="finger" class="java.lang.String"/>
	<parameter name="norawat" class="java.lang.String"/>
	<!--
	  Gambar skala nyeri: latar Wong-Baker dengan coretan perawat sudah
	  ditimpakan di atasnya, disusun di Java oleh KanvasNyeri.gambarCetak().
	  Dikirim sebagai PARAMETER, bukan field, karena satu lembar hanya punya
	  satu gambar dan penyusunannya butuh resource aplikasi (/picture/nyeri.png)
	  yang tidak bisa dijangkau dari query SQL.
	-->
	<parameter name="gambarnyeri" class="java.awt.Image" isForPrompting="false"/>

	<queryString>
		<![CDATA[select a.*,
       pasien.no_rkm_medis,pasien.nm_pasien,
       date_format(pasien.tgl_lahir,'%d-%m-%Y') as tgl_lahir,
       pasien.jk,
       concat(reg_periksa.umurdaftar,' ',reg_periksa.sttsumur) as umur,
       date_format(reg_periksa.tgl_registrasi,'%d-%m-%Y') as tgl_masuk,
       concat(date_format(a.tanggal,'%d-%m-%Y'),' ',ifnull(a.jam,'')) as tgl_asesmen,
       date_format(a.kontrol_tanggal,'%d-%m-%Y') as tgl_kontrol,
       if(reg_periksa.sttsumur in ('Bl','Hr')
          or (reg_periksa.sttsumur='Th' and cast(reg_periksa.umurdaftar as unsigned)<5),
          'Ya','Tidak') as balita,
       if(pasien.jk='P','Ya','Tidak') as perempuan,
       concat_ws('',a.balita_usia_kehamilan,a.balita_lahir_di,a.balita_ditolong,
                 a.balita_anak_ke,a.balita_bb_lahir,a.balita_tb_lahir,
                 a.balita_bbtb_sekarang,a.balita_kelainan,a.balita_mendapat,
                 a.balita_imunisasi_dasar,a.balita_imunisasi_ulang,
                 a.balita_membalikkan,a.balita_duduk,a.balita_berdiri,
                 a.balita_berjalan,a.balita_mengoceh,a.balita_berbicara) as isi_balita,
       concat_ws('',a.repro_usia_menstruasi,a.repro_siklus,a.repro_interval,
                 a.repro_jumlah,a.repro_nyeri_skala,a.repro_bercak,a.repro_hpht,
                 a.repro_keluhan_hamil,a.repro_obat,a.obs_g,a.obs_p,a.obs_o,
                 a.obs_jumlah_anak,a.obs_laki,a.obs_perempuan,a.obs_anak_terkecil,
                 a.repro_kb,a.repro_pernah,a.palpasi_tfu,a.palpasi_auskultasi,
                 a.palpasi_presentasi,a.palpasi_masuk_pap,a.janin_pergerakan,
                 a.janin_posisi,a.janin_umur_kehamilan,a.janin_masalah,
                 a.repro_informasi_lain,a.repro_dirujuk) as isi_repro,
       ifnull(pegawai.nama,'') as nm_perawat
from asesmen_awal_keperawatan_ralan a
inner join reg_periksa on a.no_rawat=reg_periksa.no_rawat
inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis
left join pegawai on a.nip=pegawai.nik
where a.no_rawat=$P{norawat}]]>
	</queryString>

