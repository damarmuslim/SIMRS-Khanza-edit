			<rectangle><reportElement mode="Transparent" x="290" y="0" width="215" height="52" uuid="d1e2f3a4-3001-0000-0000-000000001348"/></rectangle>
			<staticText><reportElement x="294" y="2" width="60" height="12" uuid="d1e2f3a4-3001-0000-0000-000000001349"/><textElement><font fontName="Tahoma" size="6"/></textElement><text><![CDATA[Nama]]></text></staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="356" y="2" width="146" height="12" uuid="d1e2f3a4-3001-0000-0000-000000001350"/><textElement><font fontName="Tahoma" size="6" isBold="true"/></textElement><textFieldExpression><![CDATA[": "+$F{nm_pasien}]]></textFieldExpression></textField>
			<staticText><reportElement x="294" y="15" width="60" height="12" uuid="d1e2f3a4-3001-0000-0000-000000001351"/><textElement><font fontName="Tahoma" size="6"/></textElement><text><![CDATA[No. RM]]></text></staticText>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement x="356" y="15" width="146" height="12" uuid="d1e2f3a4-3001-0000-0000-000000001352"/><textElement><font fontName="Tahoma" size="6" isBold="true"/></textElement><textFieldExpression><![CDATA[": "+$F{no_rkm_medis}]]></textFieldExpression></textField>
