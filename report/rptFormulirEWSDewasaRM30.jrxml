<?xml version="1.0" encoding="UTF-8"?>
<!--
  EARLY WARNING SCORING SYSTEM (DEWASA) - RM 30-1A, RSUD Demang Sepulau Raya.
  DIHASILKAN OLEH GENERATOR (scratchpad/gen_ews.py) - jangan diedit tangan,
  perubahan akan hilang saat generatornya dijalankan lagi.

  Bentuknya MATRIKS seperti kertas: pita sebagai baris, waktu pengamatan
  sebagai kolom. Satu lembar memuat 12 kolom pengamatan.

  Sel berisi skor HANYA pada baris pita yang benar-benar dipilih pada
  pengamatan itu, dicocokkan dengan teks pita yang tersimpan di database -
  bukan dengan nomor urut baris, supaya penambahan pita tidak menggeser apa pun.

  Warna baris ditentukan oleh SKOR pita itu sendiri (0 putih, 1 kuning,
  2 jingga, 3 merah), jadi warna dan angka tidak mungkin berbeda.

  Data pengamatan diratakan di Java jadi satu java.util.Map dan dibaca lewat
  $P{ews}.get("kunci") - satu parameter, bukan ratusan parameter terpisah.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="rptFormulirEWSDewasaRM30" language="groovy"
              pageWidth="595" pageHeight="842" columnWidth="482"
              leftMargin="45" rightMargin="45" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail"
              uuid="d1e2f3a4-3001-0000-0000-000000000000">

	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="norawat" class="java.lang.String"/>
	<!-- Seluruh data pengamatan, sudah diratakan di Java. -->
	<parameter name="ews" class="java.util.Map" isForPrompting="false"/>

	<queryString>
		<![CDATA[select pasien.no_rkm_medis,pasien.nm_pasien,
       date_format(pasien.tgl_lahir,'%d-%m-%Y') as tgl_lahir,
       ifnull(pasien.alamat,'') as alamat
from reg_periksa
inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis
where reg_periksa.no_rawat=$P{norawat}]]>
	</queryString>

	<field name="no_rkm_medis" class="java.lang.String"/>
	<field name="nm_pasien" class="java.lang.String"/>
	<field name="tgl_lahir" class="java.lang.String"/>
	<field name="alamat" class="java.lang.String"/>

	<title>
		<band height="86" splitType="Prevent">
