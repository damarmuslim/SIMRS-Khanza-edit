			<staticText><reportElement x="94" y="546" width="386" height="22" forecolor="#000000" uuid="d1e2f3a4-3001-0000-0000-000000001334"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="Tahoma" size="5"/></textElement><text><![CDATA[Assesment segera oleh perawat senior, eskalasi perawatan dan monitoring per 4-6 jam, jika diperlukan konsultasi ke dokter jaga]]></text></staticText>
			<rectangle><reportElement mode="Opaque" backcolor="#F5A55A" x="0" y="568" width="92" height="22" uuid="d1e2f3a4-3001-0000-0000-000000001335"/><graphicElement><pen lineWidth="0.7" lineColor="#808080"/></graphicElement></rectangle>
