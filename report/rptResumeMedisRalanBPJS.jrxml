<?xml version="1.0" encoding="UTF-8"?>
<!--
  RESUME MEDIS RAWAT JALAN BPJS - RSUD Demang Sepulau Raya.
  Satu lembar per KUNJUNGAN (satu no_rawat).

  Tiga gotcha wajib proyek ini dipatuhi di SELURUH berkas:
    1. semua textField memakai isStretchWithOverflow="true"
    2. semua staticText tingginya >= 11 (di bawah itu teks tidak tampil)
    3. semua band memakai splitType="Prevent"

  QUERY DI DALAM BERKAS INI, BUKAN DI JAVA
  Mengikuti pola tiga item cetak yang sudah ada di RMDataResumePasien
  (Laporan Resume Pasien, SBPK, SBPK 2): dipanggil dengan Valid.MyReport dan
  parameter $P{norawat}, sehingga query di bawah dijalankan sendiri oleh
  Jasper lewat Connection yang dioper.

  DUA ISIAN YANG TIDAK PUNYA KOLOM DI `resume_pasien`
  "Pemeriksaan Fisik" dan "Saran / Keterangan" ada di kertas tapi tidak ada
  kolomnya. Keputusan user: JANGAN menambah kolom, ambil saja dari catatan
  SOAP rawat jalan (`pemeriksaan_ralan` - yang diisi lewat DlgRawatJalan):
      Pemeriksaan Fisik   <- pemeriksaan          (huruf O pada SOAP)
      Saran / Keterangan  <- rtl, mundur ke instruksi bila kosong
  Diambil baris TERAKHIR: satu kunjungan bisa punya beberapa catatan SOAP, dan
  menggabung semuanya membuat kotak di kertas penuh pengulangan.

  Subquery-nya berdiri sendiri (bukan join) supaya kunjungan yang punya resume
  TAPI BELUM punya catatan SOAP tetap tercetak - kalau di-join biasa, lembarnya
  hilang diam-diam padahal datanya ada sebagian.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="rptResumeMedisRalanBPJS" language="groovy"
              pageWidth="609" pageHeight="935" columnWidth="569"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="d1e2f3a4-9900-0000-0000-000000000001">

	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="finger" class="java.lang.String"/>
	<parameter name="norawat" class="java.lang.String"/>

	<queryString>
		<![CDATA[select pasien.no_rkm_medis,pasien.nm_pasien,
       date_format(pasien.tgl_lahir,'%d-%m-%Y') as tgl_lahir,
       ifnull(pasien.alamat,'') as alamat,
       if(pasien.jk='L','Laki-Laki','Perempuan') as jk,
       date_format(reg_periksa.tgl_registrasi,'%d-%m-%Y') as tgl_periksa,
       ifnull(poliklinik.nm_poli,'') as nm_poli,
       ifnull(resume_pasien.keluhan_utama,'') as keluhan_utama,
       ifnull(resume_pasien.jalannya_penyakit,'') as jalannya_penyakit,
       concat_ws('\n',nullif(ifnull(resume_pasien.pemeriksaan_penunjang,''),''),
                      nullif(ifnull(resume_pasien.hasil_laborat,''),'')) as penunjang,
       ifnull(resume_pasien.diagnosa_utama,'') as diagnosa_utama,
       ifnull(resume_pasien.kd_diagnosa_utama,'') as kd_diagnosa_utama,
       ifnull(resume_pasien.diagnosa_sekunder,'') as diagnosa_sekunder,
       ifnull(resume_pasien.kd_diagnosa_sekunder,'') as kd_diagnosa_sekunder,
       ifnull(resume_pasien.diagnosa_sekunder2,'') as diagnosa_sekunder2,
       ifnull(resume_pasien.kd_diagnosa_sekunder2,'') as kd_diagnosa_sekunder2,
       ifnull(resume_pasien.obat_pulang,'') as obat_pulang,
       concat_ws('\n',nullif(ifnull(resume_pasien.prosedur_utama,''),''),
                      nullif(ifnull(resume_pasien.prosedur_sekunder,''),''),
                      nullif(ifnull(resume_pasien.prosedur_sekunder2,''),''),
                      nullif(ifnull(resume_pasien.prosedur_sekunder3,''),'')) as tindakan,
       ifnull(dokter.nm_dokter,'') as nm_dokter,
       ifnull(spesialis.nm_sps,'') as nm_sps,
       ifnull((select pr.pemeriksaan from pemeriksaan_ralan pr
                where pr.no_rawat=resume_pasien.no_rawat
                order by pr.tgl_perawatan desc,pr.jam_rawat desc limit 1),'') as pemeriksaan_fisik,
       ifnull((select ifnull(nullif(pr.rtl,''),pr.instruksi) from pemeriksaan_ralan pr
                where pr.no_rawat=resume_pasien.no_rawat
                order by pr.tgl_perawatan desc,pr.jam_rawat desc limit 1),'') as saran
from resume_pasien
inner join reg_periksa on resume_pasien.no_rawat=reg_periksa.no_rawat
inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis
left join poliklinik on reg_periksa.kd_poli=poliklinik.kd_poli
left join dokter on resume_pasien.kd_dokter=dokter.kd_dokter
left join spesialis on dokter.kd_sps=spesialis.kd_sps
where resume_pasien.no_rawat=$P{norawat}]]>
	</queryString>

	<field name="no_rkm_medis" class="java.lang.String"/>
	<field name="nm_pasien" class="java.lang.String"/>
	<field name="tgl_lahir" class="java.lang.String"/>
	<field name="alamat" class="java.lang.String"/>
	<field name="tgl_periksa" class="java.lang.String"/>
	<field name="nm_poli" class="java.lang.String"/>
	<field name="keluhan_utama" class="java.lang.String"/>
	<field name="jalannya_penyakit" class="java.lang.String"/>
	<field name="penunjang" class="java.lang.String"/>
	<field name="diagnosa_utama" class="java.lang.String"/>
	<field name="kd_diagnosa_utama" class="java.lang.String"/>
	<field name="diagnosa_sekunder" class="java.lang.String"/>
	<field name="kd_diagnosa_sekunder" class="java.lang.String"/>
	<field name="diagnosa_sekunder2" class="java.lang.String"/>
	<field name="kd_diagnosa_sekunder2" class="java.lang.String"/>
	<field name="obat_pulang" class="java.lang.String"/>
	<field name="tindakan" class="java.lang.String"/>
	<field name="nm_dokter" class="java.lang.String"/>
	<field name="nm_sps" class="java.lang.String"/>
	<field name="pemeriksaan_fisik" class="java.lang.String"/>
	<field name="saran" class="java.lang.String"/>

