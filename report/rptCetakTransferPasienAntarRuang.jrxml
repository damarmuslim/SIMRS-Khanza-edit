<?xml version="1.0" encoding="UTF-8"?>
<!-- [RM 04-1/04-2] Transfer Pasien Antar Ruangan - Redesign Grid Tabel Formulir IGD (RM 03) -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptCetakTransferPasienAntarRuang" language="groovy" pageWidth="609" pageHeight="935" columnWidth="569" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a1b2c3d4-0001-0002-0003-000000000001">
