				<reportElement positionType="Float" x="377" y="32" width="175" height="65" isRemoveLineWhenBlank="true"/>
				<imageExpression><![CDATA[$P{sig_penerima}]]></imageExpression>
			</image>
			<textField isStretchWithOverflow="true">
