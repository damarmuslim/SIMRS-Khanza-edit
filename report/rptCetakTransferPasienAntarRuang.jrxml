				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="7"/></textElement>
				<textFieldExpression><![CDATA[$F{nm_menerima}]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement positionType="Float" x="0" y="115" width="183" height="70"/>
				<textElement verticalAlignment="Top"><font fontName="Tahoma" size="8"/></textElement>
				<text><![CDATA[DIKETAHUI OLEH DOKTER YANG MERAWAT
(Tulis nama jelas dan tanda tangan)]]></text>
			</staticText>
			<image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" isUsingCache="false" onErrorType="Blank">
				<reportElement positionType="Float" x="377" y="117" width="175" height="65" isRemoveLineWhenBlank="true"/>
