		<!-- ===== Grid Tanda Tangan: 3 baris x 2 kolom (Yang Menyerahkan / Yang
		     Menerima), 4 dari 6 kotak terisi sesuai pemetaan yg dikonfirmasi user:
		     Baris1(Petugas Kirim&Terima): Menyerahkan=Pengirim, Menerima=Penerima
		     Baris2(Dokter): Menyerahkan=kosong, Menerima=Dokter
		     Baris3(Pasien/PJ): Menyerahkan=Pasien, Menerima=kosong ===== -->
		<band height="285" splitType="Prevent">
			<staticText>
				<reportElement positionType="Float" x="1" y="0" width="557" height="14" mode="Opaque" backcolor="#F0F0DC"/>
