				<textFieldExpression><![CDATA[$F{tanggal_masuk}==null?"-":new java.text.SimpleDateFormat("dd-MM-yyyy HH:mm").format($F{tanggal_masuk})]]></textFieldExpression>
			</textField>
			<line>
