	<detail>
		<band height="52" splitType="Prevent">
			<image scaleImage="FillFrame" isUsingCache="true" onErrorType="Blank">
				<reportElement positionType="Float" x="1" y="2" width="45" height="45"/>
				<imageExpression><![CDATA[$P{logo}]]></imageExpression>
			</image>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="50" y="1" width="295" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="11"/></textElement>
