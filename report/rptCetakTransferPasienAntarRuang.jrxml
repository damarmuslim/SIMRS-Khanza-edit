				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="7"/></textElement>
				<textFieldExpression><![CDATA["E-mail : "+$P{emailrs}]]></textFieldExpression>
			</textField>
			<rectangle>
				<reportElement positionType="Float" x="350" y="0" width="205" height="48"/>
			</rectangle>
			<staticText>
				<reportElement positionType="Float" x="354" y="1" width="62" height="11"/>
				<textElement verticalAlignment="Middle"><font fontName="Tahoma" size="7"/></textElement>
				<text><![CDATA[No. RM :]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="419" y="1" width="132" height="11"/>
				<textElement verticalAlignment="Middle"><font fontName="Tahoma" size="7"/></textElement>
				<textFieldExpression><![CDATA[$F{no_rkm_medis}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="354" y="12" width="62" height="11"/>
				<textElement verticalAlignment="Middle"><font fontName="Tahoma" size="7"/></textElement>
				<text><![CDATA[Nama :]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="419" y="12" width="132" height="11"/>
				<textElement verticalAlignment="Middle"><font fontName="Tahoma" size="7"/></textElement>
				<textFieldExpression><![CDATA[$F{nm_pasien}+($F{jk}==null?"":" ("+$F{jk}+")")]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="354" y="23" width="62" height="11"/>
				<textElement verticalAlignment="Middle"><font fontName="Tahoma" size="7"/></textElement>
				<text><![CDATA[Tgl Lahir :]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="419" y="23" width="132" height="11"/>
				<textElement verticalAlignment="Middle"><font fontName="Tahoma" size="7"/></textElement>
				<textFieldExpression><![CDATA[$F{tgl_lahir}==null?"-":new java.text.SimpleDateFormat("dd-MM-yyyy").format($F{tgl_lahir})]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="354" y="34" width="62" height="11"/>
				<textElement verticalAlignment="Middle"><font fontName="Tahoma" size="7"/></textElement>
