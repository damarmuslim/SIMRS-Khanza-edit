			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="371" y="183" width="186" height="11"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Tahoma" size="7"/></textElement>
				<!--
				  Fallback bertingkat: dokter asal -> dokter tujuan -> "-".
				  Cabang "-" terakhir WAJIB: formulir fisik cuma punya satu baris
				  tanda tangan dokter generik, dan pada data sungguhan kd_dokter
				  asal maupun tujuan sering-sering sama-sama kosong. Tanpa cabang
				  itu ekspresi menghasilkan null dan JasperReports mencetak tulisan
				  harfiah "null" di atas garis tanda tangan.
				-->
				<textFieldExpression><![CDATA[$F{nm_dokter_asal_1}!=null?$F{nm_dokter_asal_1}:($F{nm_dokter_tujuan_1}!=null?$F{nm_dokter_tujuan_1}:"-")]]></textFieldExpression>
