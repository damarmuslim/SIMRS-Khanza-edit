				<textFieldExpression><![CDATA[($F{diagnosa_utama}==null?"":$F{diagnosa_utama})+(($F{diagnosa_sekunder}!=null&&!$F{diagnosa_sekunder}.equals(""))?" / "+$F{diagnosa_sekunder}:"")]]></textFieldExpression>
