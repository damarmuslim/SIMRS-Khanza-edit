-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rptAsesmenMedisRanapRM20_1" language="groovy" pageWidth="609" pageHeight="935" columnWidth="569" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c8d42b31-62ef-411b-aa22-3d5f8e011234">
	<parameter name="namars" class="java.lang.String"/>
	<parameter name="alamatrs" class="java.lang.String"/>
	<parameter name="kotars" class="java.lang.String"/>
	<parameter name="propinsirs" class="java.lang.String"/>
	<parameter name="kontakrs" class="java.lang.String"/>
	<parameter name="emailrs" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream"/>
	<parameter name="finger_periksa" class="java.lang.String"/>
	<parameter name="finger_dpjp" class="java.lang.String"/>
	<parameter name="lokalis_canvas_img" class="java.io.InputStream"/>
	<queryString>
		<![CDATA[select asesmen_medis_ranap_rm20_1.*,pasien.no_rkm_medis,pasien.nm_pasien,pasien.tgl_lahir,if(pasien.jk='L','Laki-Laki','Perempuan') as jk,concat(reg_periksa.umurdaftar,' ',reg_periksa.sttsumur) as umur_pasien,reg_periksa.tgl_registrasi,reg_periksa.jam_reg,dokterperiksa.nm_dokter as nm_dokter_periksa,dokterperiksa.no_ijn_praktek as ijin_periksa,dokterdpjp.nm_dokter as nm_dokter_dpjp,dokterdpjp.no_ijn_praktek as ijin_dpjp,coalesce((select bangsal.nm_bangsal from kamar_inap inner join kamar on kamar_inap.kd_kamar=kamar.kd_kamar inner join bangsal on kamar.kd_bangsal=bangsal.kd_bangsal where kamar_inap.no_rawat=asesmen_medis_ranap_rm20_1.no_rawat order by kamar_inap.tgl_masuk desc limit 1),'-') as nm_bangsal from asesmen_medis_ranap_rm20_1 inner join reg_periksa on asesmen_medis_ranap_rm20_1.no_rawat=reg_periksa.no_rawat inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis left join dokter dokterperiksa on asesmen_medis_ranap_rm20_1.kd_dokter_periksa=dokterperiksa.kd_dokter left join dokter dokterdpjp on asesmen_medis_ranap_rm20_1.kd_dokter_dpjp=dokterdpjp.kd_dokter]]>
	</queryString>
	<field name="no_rawat" class="java.lang.String"/>
	<field name="tanggal" class="java.lang.String"/>
