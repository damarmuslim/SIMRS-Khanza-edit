        skala1Panel.add(baris("Cari",TCariSkala1,BtnCariSkala1,BtnTambahSkala1),java.awt.BorderLayout.NORTH);
        widget.ScrollPane scrollSkala1 = new widget.ScrollPane(); scrollSkala1.setViewportView(tbSkala1);
        skala1Panel.add(scrollSkala1,java.awt.BorderLayout.CENTER);
        widget.PanelBiasa skala2Panel = new widget.PanelBiasa(new java.awt.BorderLayout());
        skala2Panel.add(baris("Cari",TCariSkala3,BtnCariSkala2,BtnTambahSkala2),java.awt.BorderLayout.NORTH);
        widget.ScrollPane scrollSkala2 = new widget.ScrollPane(); scrollSkala2.setViewportView(tbSkala2);
        skala2Panel.add(scrollSkala2,java.awt.BorderLayout.CENTER);
        TabSkala1dan2.addTab("Skala 1 - Immediate/Segera",skala1Panel);
        TabSkala1dan2.addTab("Skala 2 - Emergensi",skala2Panel);

        widget.PanelBiasa pemeriksaanPanel = new widget.PanelBiasa(new java.awt.BorderLayout());
        pemeriksaanPanel.add(baris("Cari Pemeriksaan",TCariPemeriksaan,BtnCariPemeriksaan,BtnTambahPemeriksaan),java.awt.BorderLayout.NORTH);
        widget.ScrollPane scrollPemeriksaan = new widget.ScrollPane(); scrollPemeriksaan.setViewportView(tbPemeriksaan);
        pemeriksaanPanel.add(scrollPemeriksaan,java.awt.BorderLayout.WEST);
        pemeriksaanPanel.add(TabSkala1dan2,java.awt.BorderLayout.CENTER);
        primer.add(pemeriksaanPanel,java.awt.BorderLayout.CENTER);

        // ---- tab Sekunder ----
        widget.PanelBiasa sekunder = new widget.PanelBiasa(new java.awt.BorderLayout());
        widget.PanelBiasa sekunderAtas = new widget.PanelBiasa(new java.awt.GridLayout(0,1,0,2));
        sekunderAtas.add(baris("Anamnesa",SekunderAnamnesa));
        sekunderAtas.add(baris("Tanggal Triase",SekunderTanggalTriase));
        sekunderAtas.add(baris("Tensi/Nadi/Respirasi",SekunderTensi,SekunderNadi,SekunderRespirasi));
        sekunderAtas.add(baris("Suhu/Saturasi/Nyeri",SekunderSuhu,SekunderSaturasi,SekunderNyeri));
        sekunderAtas.add(baris("Catatan",SekunderCatatan));
        sekunderAtas.add(baris("Petugas",SekunderKodePetugas,SekunderNamaPetugas,btnSekunderPetugas));
        widget.PanelBiasa sekunderKeputusan = new widget.PanelBiasa();
        sekunderKeputusan.setLayout(new java.awt.FlowLayout(java.awt.FlowLayout.LEFT));
        sekunderKeputusan.add(SekunderZonaKuning); sekunderKeputusan.add(SekunderZonaHijau);
        sekunderAtas.add(sekunderKeputusan);
        sekunder.add(sekunderAtas,java.awt.BorderLayout.NORTH);

        widget.PanelBiasa skala3Panel = new widget.PanelBiasa(new java.awt.BorderLayout());
        widget.ScrollPane scrollSkala3 = new widget.ScrollPane(); scrollSkala3.setViewportView(tbSkala3);
        skala3Panel.add(scrollSkala3,java.awt.BorderLayout.CENTER);
        widget.PanelBiasa skala4Panel = new widget.PanelBiasa(new java.awt.BorderLayout());
        widget.ScrollPane scrollSkala4 = new widget.ScrollPane(); scrollSkala4.setViewportView(tbSkala4);
        skala4Panel.add(scrollSkala4,java.awt.BorderLayout.CENTER);
        widget.PanelBiasa skala5Panel = new widget.PanelBiasa(new java.awt.BorderLayout());
        widget.ScrollPane scrollSkala5 = new widget.ScrollPane(); scrollSkala5.setViewportView(tbSkala5);
        skala5Panel.add(scrollSkala5,java.awt.BorderLayout.CENTER);
        TabSkala3dan4dan5.addTab("Skala 3 - Urgensi",skala3Panel);
        TabSkala3dan4dan5.addTab("Skala 4 - Semi/Rendah",skala4Panel);
        TabSkala3dan4dan5.addTab("Skala 5 - Non Urgensi",skala5Panel);

        widget.PanelBiasa pemeriksaan2Panel = new widget.PanelBiasa(new java.awt.BorderLayout());
        pemeriksaan2Panel.add(baris("Cari Pemeriksaan",TCariPemeriksaan2,BtnCariPemeriksaan1,BtnTambahPemeriksaan1),java.awt.BorderLayout.NORTH);
        widget.ScrollPane scrollPemeriksaan2 = new widget.ScrollPane(); scrollPemeriksaan2.setViewportView(tbPemeriksaan2);
        pemeriksaan2Panel.add(scrollPemeriksaan2,java.awt.BorderLayout.WEST);
        pemeriksaan2Panel.add(TabSkala3dan4dan5,java.awt.BorderLayout.CENTER);
        sekunder.add(pemeriksaan2Panel,java.awt.BorderLayout.CENTER);

        TabTriase.addTab("Primer",primer);
        TabTriase.addTab("Sekunder",sekunder);
        // Tab "PACS" ditambahkan belakangan oleh initPacsTab() (dipanggil di akhir konstruktor).

        // ---- panel accordion riwayat (kanan) ----
        FormMenu.add(baris("Riwayat Triase"),java.awt.BorderLayout.NORTH);
        FormMenu.add(ScrollHTML,java.awt.BorderLayout.CENTER);
        PanelAccor.add(FormMenu,java.awt.BorderLayout.CENTER);

        widget.PanelBiasa formIsi = new widget.PanelBiasa(new java.awt.BorderLayout());
        formIsi.add(TabTriase,java.awt.BorderLayout.CENTER);
        formIsi.add(PanelAccor,java.awt.BorderLayout.EAST);

        FormTriase.add(header,java.awt.BorderLayout.NORTH);
        FormTriase.add(formIsi,java.awt.BorderLayout.CENTER);

        // ---- tab Data (daftar triase) ----
        widget.PanelBiasa dataPanel = new widget.PanelBiasa(new java.awt.BorderLayout());
        dataPanel.add(baris("Tanggal",DTPCari1,"s/d",DTPCari2,"Cari",TCari,BtnCari,BtnAll,"Jumlah",LCount),java.awt.BorderLayout.NORTH);
        dataPanel.add(ScrollTriase,java.awt.BorderLayout.CENTER);

        TabPilihan.addTab("Form",FormTriase);
        TabPilihan.addTab("Data",dataPanel);

        this.setLayout(new java.awt.BorderLayout());
        this.add(TabPilihan,java.awt.BorderLayout.CENTER);
        this.setSize(1000,700);
    }

    // =====================================================================
    // [PACS] Field baru - Patient's Acuity Categorization Scale (formulir
    // target RM 03-1). Ditambahkan terisolasi di luar blok GEN-BEGIN/GEN-END
    // di atas supaya TIDAK ikut ditimpa NetBeans Form Editor saat form lama
    // (Skala 1-5 Primer/Sekunder) dibuka/disimpan ulang lewat GUI builder.
    // Tab ini berdampingan dengan tab Primer/Sekunder yang sudah ada -
    // tidak mengubah/menghapus fungsi Triase lama.
    // =====================================================================
    private widget.PanelBiasa PanelPacs;
    private widget.TextBox PacsTensi, PacsNadi, PacsRespirasi, PacsSuhu, PacsSaturasi, PacsNyeri;
    private widget.ComboBox PacsKesadaran;
    private widget.TextBox PacsBeratBadan, PacsTinggiBadan;
    private widget.ComboBox CmbSkorKesadaranPacs, CmbSkorTDPacs, CmbSkorNadiPacs, CmbSkorRespirasiPacs, CmbSkorTemperaturPacs, CmbSkorSaturasiPacs;
    private widget.Label LblTotalSkorPacs;
    private widget.RadioButton RbPacs1, RbPacs2, RbPacs3, RbPacs4;
    private javax.swing.ButtonGroup bgLevelPacs;
    private widget.RadioButton RbPacsResusitasi, RbPacsNonResusitasi, RbPacsPoliKlinik, RbPacsDOA;
    private javax.swing.ButtonGroup bgKeputusanPacs;
    private widget.Tanggal DTPTanggalTriasePacs, DTPKeputusanPukulPacs;
    private widget.TextBox PacsKodePetugas, PacsNamaPetugas;
    private widget.Button btnPacsPetugas;
    private widget.Button btnPrintPacs;
    // -- Kelompok A sisa: Kontak Awal, Sudah Terpasang, Identitas Pengantar, Keluhan --
    private widget.Tanggal PacsKontakAwal;
    private widget.CekBox PacsInfus, PacsNgt, PacsKateter;
    private widget.TextBox PacsNamaPengantar, PacsTelpPengantar;
    private widget.TextArea PacsKeluhanUtama;
    // -- Kelompok B: Mekanisme Trauma (tampil hanya jika Kasus = Trauma) --
    private widget.PanelBiasa panelMekanismeTrauma;
    private widget.CekBox CekKklTunggal, CekKklDenganLawan, CekJatuhKetinggian, CekLukaBakar, CekTraumaFisik, CekTraumaZatKimia, CekTraumaZatLainnya;
    private widget.TextBox TKklLawan, TKklTempatKejadian, TJatuhKetinggianKet, TLukaBakarKet, TTraumaFisikKet, TTraumaZatKimiaKet, TTraumaZatLainnyaKet;
    private widget.Tanggal DTPKklKejadian;

    /**
     * Membangun tab "PACS" secara terpisah dari initComponents() (blok
     * GEN-BEGIN/GEN-END) sesuai pola Khanza yang sudah ada (widget.* +
     * widget.Tanggal utk tanggal/jam, widget.Button utk buka DlgCariPegawai).
     * Dipanggil sekali dari constructor, setelah initComponents().
     */
    private void initPacsTab(){
        PanelPacs = new widget.PanelBiasa();
        PanelPacs.setLayout(new java.awt.GridBagLayout());
        java.awt.GridBagConstraints c;
        int row = 0;

        row = tambahBarisPacsLabel(row, "Triase (PACS)");
        row = tambahBarisPacsField(row, "Kontak Awal Pasien", PacsKontakAwal = new widget.Tanggal());
        PacsKontakAwal.setDate(new Date());

        widget.PanelBiasa panelTerpasang = new widget.PanelBiasa();
        panelTerpasang.setLayout(new java.awt.FlowLayout(java.awt.FlowLayout.LEFT));
        CekBoxIsiTeks(PacsInfus = new widget.CekBox(),"Infus");
        CekBoxIsiTeks(PacsNgt = new widget.CekBox(),"NGT");
        CekBoxIsiTeks(PacsKateter = new widget.CekBox(),"Kateter Urin");
        panelTerpasang.add(PacsInfus); panelTerpasang.add(PacsNgt); panelTerpasang.add(PacsKateter);
        row = tambahBarisPacsLabel(row, "Sudah Terpasang");
        c = pacsConstraint(1,row); PanelPacs.add(panelTerpasang,c); row++;

        widget.PanelBiasa panelPengantar = new widget.PanelBiasa();
        panelPengantar.setLayout(new java.awt.FlowLayout(java.awt.FlowLayout.LEFT));
        PacsNamaPengantar = new widget.TextBox(); PacsNamaPengantar.setColumns(18);
        PacsTelpPengantar = new widget.TextBox(); PacsTelpPengantar.setColumns(14);
        panelPengantar.add(pacsLabelTeks("Nama :")); panelPengantar.add(PacsNamaPengantar);
        panelPengantar.add(pacsLabelTeks("Telp :")); panelPengantar.add(PacsTelpPengantar);
        row = tambahBarisPacsLabel(row, "Identitas Pengantar");
        c = pacsConstraint(1,row); PanelPacs.add(panelPengantar,c); row++;

        // [Mekanisme Trauma] Hanya tampil kalau Kasus = Trauma (KdKasus != "004").
        // Diperbarui oleh perbaruiVisibilitasMekanismeTrauma() - dipanggil dari
        // btnKasusActionPerformed, tampilPacs(), dan resetPacsTab().
        row = tambahBarisPacsLabel(row, "Mekanisme Trauma (khusus Kasus = Trauma)");
        panelMekanismeTrauma = new widget.PanelBiasa();
        panelMekanismeTrauma.setLayout(new java.awt.GridBagLayout());
        int rowMt = 0;
        java.awt.GridBagConstraints cmt;

        CekBoxIsiTeks(CekKklTunggal = new widget.CekBox(),"KKL Tunggal");
        CekBoxIsiTeks(CekKklDenganLawan = new widget.CekBox(),"KKL dengan lawan");
        widget.PanelBiasa panelKkl = new widget.PanelBiasa();
        panelKkl.setLayout(new java.awt.FlowLayout(java.awt.FlowLayout.LEFT));
        panelKkl.add(CekKklTunggal); panelKkl.add(CekKklDenganLawan);
        cmt = pacsConstraint(0,rowMt); cmt.gridwidth=2; panelMekanismeTrauma.add(panelKkl,cmt); rowMt++;

        TKklLawan = new widget.TextBox();
        cmt = pacsConstraint(0,rowMt); panelMekanismeTrauma.add(pacsLabelTeks("Lawan :"),cmt);
        cmt = pacsConstraint(1,rowMt); panelMekanismeTrauma.add(TKklLawan,cmt); rowMt++;

        TKklTempatKejadian = new widget.TextBox();
        cmt = pacsConstraint(0,rowMt); panelMekanismeTrauma.add(pacsLabelTeks("Tempat Kejadian :"),cmt);
        cmt = pacsConstraint(1,rowMt); panelMekanismeTrauma.add(TKklTempatKejadian,cmt); rowMt++;

        DTPKklKejadian = new widget.Tanggal(); DTPKklKejadian.setDate(new Date());
        cmt = pacsConstraint(0,rowMt); panelMekanismeTrauma.add(pacsLabelTeks("Tanggal & Pukul Kejadian :"),cmt);
        cmt = pacsConstraint(1,rowMt); panelMekanismeTrauma.add(DTPKklKejadian,cmt); rowMt++;

        rowMt = tambahBarisMekanismeTrauma(panelMekanismeTrauma,rowMt,"Jatuh dari Ketinggian",CekJatuhKetinggian = new widget.CekBox(),TJatuhKetinggianKet = new widget.TextBox());
        rowMt = tambahBarisMekanismeTrauma(panelMekanismeTrauma,rowMt,"Luka Bakar",CekLukaBakar = new widget.CekBox(),TLukaBakarKet = new widget.TextBox());
        rowMt = tambahBarisMekanismeTrauma(panelMekanismeTrauma,rowMt,"Trauma Fisik",CekTraumaFisik = new widget.CekBox(),TTraumaFisikKet = new widget.TextBox());
        rowMt = tambahBarisMekanismeTrauma(panelMekanismeTrauma,rowMt,"Trauma Zat Kimia",CekTraumaZatKimia = new widget.CekBox(),TTraumaZatKimiaKet = new widget.TextBox());
        rowMt = tambahBarisMekanismeTrauma(panelMekanismeTrauma,rowMt,"Trauma Zat Lainnya",CekTraumaZatLainnya = new widget.CekBox(),TTraumaZatLainnyaKet = new widget.TextBox());

        c = pacsConstraint(0,row); c.gridwidth=2; PanelPacs.add(panelMekanismeTrauma,c); row++;
        panelMekanismeTrauma.setVisible(false);

        row = tambahBarisPacsField(row, "Keluhan Utama", PacsKeluhanUtama = new widget.TextArea());

        row = tambahBarisPacsLabel(row, "Tanda Vital (PACS)");
        row = tambahBarisPacsField(row, "Tekanan Darah", PacsTensi = new widget.TextBox());
        row = tambahBarisPacsField(row, "Nadi (/menit)", PacsNadi = new widget.TextBox());
        row = tambahBarisPacsField(row, "Pernapasan (/menit)", PacsRespirasi = new widget.TextBox());
        row = tambahBarisPacsField(row, "Suhu (C)", PacsSuhu = new widget.TextBox());
        row = tambahBarisPacsField(row, "Saturasi O2 (%)", PacsSaturasi = new widget.TextBox());
        row = tambahBarisPacsField(row, "Nyeri", PacsNyeri = new widget.TextBox());

        PacsKesadaran = new widget.ComboBox();
        PacsKesadaran.addItem("Sadar Penuh");
        PacsKesadaran.addItem("Respon Suara");
        PacsKesadaran.addItem("Respon Nyeri");
        PacsKesadaran.addItem("Tidak Respon");
        row = tambahBarisPacsField(row, "Kesadaran (AVPU)", PacsKesadaran);
        row = tambahBarisPacsField(row, "Berat Badan (kg)", PacsBeratBadan = new widget.TextBox());
        row = tambahBarisPacsField(row, "Tinggi Badan (cm)", PacsTinggiBadan = new widget.TextBox());

        // [PACS] Stage: skor 0-3 dihitung otomatis (bukan dipilih manual) begitu
        // petugas selesai mengisi tanda vital - lihat hitungSkorOtomatisPacs()
        // yang murni memanggil kelas PacsScoring (aturan sesuai formulir).
        java.awt.event.FocusAdapter pemicuSkorOtomatis = new java.awt.event.FocusAdapter(){
            @Override
            public void focusLost(java.awt.event.FocusEvent e){
                hitungSkorOtomatisPacs();
            }
        };
        PacsTensi.addFocusListener(pemicuSkorOtomatis);
        PacsNadi.addFocusListener(pemicuSkorOtomatis);
        PacsRespirasi.addFocusListener(pemicuSkorOtomatis);
        PacsSuhu.addFocusListener(pemicuSkorOtomatis);
        PacsSaturasi.addFocusListener(pemicuSkorOtomatis);
        PacsKesadaran.addItemListener((java.awt.event.ItemEvent e) -> hitungSkorOtomatisPacs());

        row = tambahBarisPacsLabel(row, "Level Triage (PACS)");
        widget.PanelBiasa panelLevel = new widget.PanelBiasa();
        panelLevel.setLayout(new java.awt.FlowLayout(java.awt.FlowLayout.LEFT));
        bgLevelPacs = new javax.swing.ButtonGroup();
        RbPacs1 = new widget.RadioButton(); RbPacs1.setText(PacsLevel.PACS_1.getLabel()); pewarnaanTombolPacs(RbPacs1,PacsLevel.PACS_1);
        RbPacs2 = new widget.RadioButton(); RbPacs2.setText(PacsLevel.PACS_2.getLabel()); pewarnaanTombolPacs(RbPacs2,PacsLevel.PACS_2);
        RbPacs3 = new widget.RadioButton(); RbPacs3.setText(PacsLevel.PACS_3.getLabel()); pewarnaanTombolPacs(RbPacs3,PacsLevel.PACS_3);
        RbPacs4 = new widget.RadioButton(); RbPacs4.setText(PacsLevel.PACS_4.getLabel()); pewarnaanTombolPacs(RbPacs4,PacsLevel.PACS_4);
        bgLevelPacs.add(RbPacs1); bgLevelPacs.add(RbPacs2); bgLevelPacs.add(RbPacs3); bgLevelPacs.add(RbPacs4);
        panelLevel.add(RbPacs1); panelLevel.add(RbPacs2); panelLevel.add(RbPacs3); panelLevel.add(RbPacs4);
        c = pacsConstraint(1,row); PanelPacs.add(panelLevel,c); row++;

        row = tambahBarisPacsLabel(row, "Skor EWS (0-3 per parameter)");
        row = tambahBarisPacsField(row, "Skor Kesadaran", CmbSkorKesadaranPacs = buatComboSkor());
        row = tambahBarisPacsField(row, "Skor TD Sistolik", CmbSkorTDPacs = buatComboSkor());
        row = tambahBarisPacsField(row, "Skor Nadi", CmbSkorNadiPacs = buatComboSkor());
        row = tambahBarisPacsField(row, "Skor Respirasi", CmbSkorRespirasiPacs = buatComboSkor());
        row = tambahBarisPacsField(row, "Skor Temperatur", CmbSkorTemperaturPacs = buatComboSkor());
        row = tambahBarisPacsField(row, "Skor Saturasi O2", CmbSkorSaturasiPacs = buatComboSkor());
        java.awt.event.ItemListener hitungSkor = (java.awt.event.ItemEvent e) -> hitungTotalSkorPacs();
        CmbSkorKesadaranPacs.addItemListener(hitungSkor);
        CmbSkorTDPacs.addItemListener(hitungSkor);
        CmbSkorNadiPacs.addItemListener(hitungSkor);
        CmbSkorRespirasiPacs.addItemListener(hitungSkor);
        CmbSkorTemperaturPacs.addItemListener(hitungSkor);
        CmbSkorSaturasiPacs.addItemListener(hitungSkor);

        LblTotalSkorPacs = new widget.Label();
        LblTotalSkorPacs.setText("0");
        row = tambahBarisPacsField(row, "Total Skor", LblTotalSkorPacs);

        row = tambahBarisPacsLabel(row, "Keputusan");
        widget.PanelBiasa panelKeputusan = new widget.PanelBiasa();
        panelKeputusan.setLayout(new java.awt.GridLayout(4,1));
        bgKeputusanPacs = new javax.swing.ButtonGroup();
        RbPacsResusitasi = new widget.RadioButton(); RbPacsResusitasi.setText("Ruang Resusitasi");
        RbPacsNonResusitasi = new widget.RadioButton(); RbPacsNonResusitasi.setText("Ruang Non Resusitasi");
        RbPacsPoliKlinik = new widget.RadioButton(); RbPacsPoliKlinik.setText("Poli Klinik/Klinik Umum 24 Jam");
        RbPacsDOA = new widget.RadioButton(); RbPacsDOA.setText("Death On Arrival");
        bgKeputusanPacs.add(RbPacsResusitasi); bgKeputusanPacs.add(RbPacsNonResusitasi);
        bgKeputusanPacs.add(RbPacsPoliKlinik); bgKeputusanPacs.add(RbPacsDOA);
        panelKeputusan.add(RbPacsResusitasi); panelKeputusan.add(RbPacsNonResusitasi);
        panelKeputusan.add(RbPacsPoliKlinik); panelKeputusan.add(RbPacsDOA);
        c = pacsConstraint(1,row); PanelPacs.add(panelKeputusan,c); row++;

        row = tambahBarisPacsField(row, "Pukul Keputusan", DTPKeputusanPukulPacs = new widget.Tanggal());
        row = tambahBarisPacsField(row, "Tanggal & Jam Triase", DTPTanggalTriasePacs = new widget.Tanggal());
        DTPTanggalTriasePacs.setDate(new Date());
        DTPKeputusanPukulPacs.setDate(new Date());

        widget.PanelBiasa panelPetugas = new widget.PanelBiasa();
        panelPetugas.setLayout(new java.awt.FlowLayout(java.awt.FlowLayout.LEFT));
        PacsKodePetugas = new widget.TextBox(); PacsKodePetugas.setEditable(false); PacsKodePetugas.setColumns(6);
        PacsNamaPetugas = new widget.TextBox(); PacsNamaPetugas.setEditable(false); PacsNamaPetugas.setColumns(20);
        btnPacsPetugas = new widget.Button(); btnPacsPetugas.setText("Cari Petugas");
        btnPacsPetugas.addActionListener((java.awt.event.ActionEvent evt) -> btnPacsPetugasActionPerformed(evt));
        panelPetugas.add(PacsKodePetugas); panelPetugas.add(PacsNamaPetugas); panelPetugas.add(btnPacsPetugas);
        row = tambahBarisPacsLabel(row, "Petugas Triase (PACS)");
        c = pacsConstraint(1,row); PanelPacs.add(panelPetugas,c); row++;

        widget.PanelBiasa panelCetak = new widget.PanelBiasa();
        panelCetak.setLayout(new java.awt.FlowLayout(java.awt.FlowLayout.LEFT));
        btnPrintPacs = new widget.Button(); btnPrintPacs.setText("Cetak Lembar Triase PACS");
        btnPrintPacs.addActionListener((java.awt.event.ActionEvent evt) -> btnPrintPacsActionPerformed(evt));
        panelCetak.add(btnPrintPacs);
        c = pacsConstraint(1,row); PanelPacs.add(panelCetak,c); row++;

        // [PACS] Isi tab ini panjang (banyak seksi baru). Dibungkus widget.ScrollPane
        // dengan ukuran preferred TETAP (bukan mengikuti tinggi asli kontennya), persis
        // pola yang sudah dipakai tab Primer/Sekunder (ScrollTriase, ScrollHTML, dst.) -
        // supaya TabTriase TIDAK melaporkan ukuran preferred raksasa ke layout di atasnya
        // (yang bisa memaksa seluruh dialog/tab Primer-Sekunder ikut menyusut/bergeser).
        // Ukuran diselaraskan dengan area konten yang sudah tersedia (internalFrame1
        // 1000x700, lihat baris internalFrame1.setSize di atas) - desain Primer/Sekunder
        // yang lama TIDAK diubah sama sekali.
        widget.ScrollPane scrollPacs = new widget.ScrollPane();
        scrollPacs.setViewportView(PanelPacs);
        scrollPacs.setPreferredSize(new java.awt.Dimension(960,420));
        TabTriase.addTab("PACS", scrollPacs);
        perbaruiVisibilitasMekanismeTrauma();
    }

    /** Item 3/6: tampilkan warna cetak PacsLevel di tombol pilihan form (PacsLevel.getWarnaCetakHex()). */
    private void pewarnaanTombolPacs(widget.RadioButton tombol,PacsLevel level){
        tombol.setOpaque(true);
        tombol.setBackground(java.awt.Color.decode(level.getWarnaCetakHex()));
        tombol.setForeground(java.awt.Color.WHITE);
    }

    /**
     * Skor 0-3 dihitung OTOMATIS dari nilai tanda vital (lihat
     * hitungSkorOtomatisPacs() / kelas PacsScoring) - combo ini jadi
     * tampilan hasil (read-only), bukan pilihan manual petugas lagi.
     * Item "?" dipakai saat nilai input di luar kategori formulir
     * (mis. Nadi >=103) - lihat PacsScoring.skorNadi().
     */
    private widget.ComboBox buatComboSkor(){
        widget.ComboBox cmb = new widget.ComboBox();
        cmb.addItem("0"); cmb.addItem("1"); cmb.addItem("2"); cmb.addItem("3"); cmb.addItem("?");
        cmb.setEnabled(false);
        return cmb;
    }

    private void CekBoxIsiTeks(widget.CekBox cek,String teks){
        cek.setText(teks);
    }

    private widget.Label pacsLabelTeks(String teks){
        widget.Label lbl = new widget.Label();
        lbl.setText(teks);
        return lbl;
    }

    /** Satu baris "[checkbox Ya/Tidak] [keterangan]" utk satu kategori Mekanisme Trauma. */
    private int tambahBarisMekanismeTrauma(widget.PanelBiasa panel,int rowMt,String label,widget.CekBox cek,widget.TextBox ket){
        cek.setText(label);
        java.awt.GridBagConstraints c1 = pacsConstraint(0,rowMt);
        panel.add(cek,c1);
        java.awt.GridBagConstraints c2 = pacsConstraint(1,rowMt);
        panel.add(ket,c2);
        return rowMt+1;
    }

    /**
     * [Mekanisme Trauma] Tampil HANYA kalau Kasus terpilih = Trauma
     * (KdKasus != "004" - "004" = Non Trauma, sesuai master_triase_macam_kasus).
     * Kalau Non Trauma: panel disembunyikan DAN seluruh isiannya dikosongkan,
     * supaya tidak ada data mekanisme trauma "nyangkut" ikut tersimpan untuk
     * kasus non-trauma (hasil cetak jadi kosong sesuai permintaan).
     */
    private void perbaruiVisibilitasMekanismeTrauma(){
        boolean trauma = !KdKasus.getText().trim().equals("004") && !KdKasus.getText().trim().isEmpty();
        panelMekanismeTrauma.setVisible(trauma);
        if(!trauma){
            CekKklTunggal.setSelected(false);
            CekKklDenganLawan.setSelected(false);
            TKklLawan.setText("");
            TKklTempatKejadian.setText("");
            DTPKklKejadian.setDate(new Date());
            CekJatuhKetinggian.setSelected(false);
            TJatuhKetinggianKet.setText("");
            CekLukaBakar.setSelected(false);
            TLukaBakarKet.setText("");
            CekTraumaFisik.setSelected(false);
            TTraumaFisikKet.setText("");
            CekTraumaZatKimia.setSelected(false);
            TTraumaZatKimiaKet.setText("");
            CekTraumaZatLainnya.setSelected(false);
            TTraumaZatLainnyaKet.setText("");
        }
    }

    private java.awt.GridBagConstraints pacsConstraint(int gridx,int gridy){
        java.awt.GridBagConstraints c = new java.awt.GridBagConstraints();
        c.gridx = gridx; c.gridy = gridy;
        c.anchor = java.awt.GridBagConstraints.WEST;
        c.insets = new java.awt.Insets(3,5,3,5);
        c.fill = java.awt.GridBagConstraints.HORIZONTAL;
        return c;
    }

    private int tambahBarisPacsLabel(int row,String judul){
        widget.Label lbl = new widget.Label();
        lbl.setText(judul);
        lbl.setFont(lbl.getFont().deriveFont(java.awt.Font.BOLD));
        java.awt.GridBagConstraints c = pacsConstraint(0,row);
        c.gridwidth = 2;
        PanelPacs.add(lbl,c);
        return row+1;
    }

    private int tambahBarisPacsField(int row,String label,java.awt.Component field){
        widget.Label lbl = new widget.Label();
        lbl.setText(label+" :");
        java.awt.GridBagConstraints c1 = pacsConstraint(0,row);
        PanelPacs.add(lbl,c1);
        java.awt.GridBagConstraints c2 = pacsConstraint(1,row);
        PanelPacs.add(field,c2);
        return row+1;
    }

    private void btnPacsPetugasActionPerformed(java.awt.event.ActionEvent evt) {
        DlgCariPegawai pegawai=new DlgCariPegawai(null,false);
        pegawai.addWindowListener(new WindowListener() {
            @Override
            public void windowOpened(WindowEvent e) {}
            @Override
            public void windowClosing(WindowEvent e) {}
            @Override
            public void windowClosed(WindowEvent e) {
                if(pegawai.getTable().getSelectedRow()!= -1){
                    PacsKodePetugas.setText(pegawai.getTable().getValueAt(pegawai.getTable().getSelectedRow(),0).toString());
                    PacsNamaPetugas.setText(pegawai.getTable().getValueAt(pegawai.getTable().getSelectedRow(),1).toString());
                    btnPacsPetugas.requestFocus();
                }
            }
            @Override
            public void windowIconified(WindowEvent e) {}
            @Override
            public void windowDeiconified(WindowEvent e) {}
            @Override
            public void windowActivated(WindowEvent e) {}
            @Override
            public void windowDeactivated(WindowEvent e) {}
        });
        pegawai.setSize(internalFrame1.getWidth()-20,internalFrame1.getHeight()-20);
        pegawai.setLocationRelativeTo(internalFrame1);
        pegawai.setAlwaysOnTop(false);
        pegawai.setVisible(true);
    }

    /**
     * Cetak "rptLembarTriasePacs.jasper" (formulir RM 03-1). Pola sama persis
     * dengan BtnPrintActionPerformed("Laporan 1") - MyReportqry butuh SQL
     * jadi (bukan JRXML queryString) karena datanya dilewatkan lewat
     * JRResultSetDataSource, bukan dieksekusi ulang dari dalam file .jasper.
     */
    private void btnPrintPacsActionPerformed(java.awt.event.ActionEvent evt){
        if(TNoRw.getText().trim().equals("")){
            Valid.textKosong(TNoRw,"Pasien");
            return;
        }
        Map<String,Object> param = new HashMap<>();
        param.put("namars",akses.getnamars());
        param.put("alamatrs",akses.getalamatrs());
        param.put("kotars",akses.getkabupatenrs());
        param.put("propinsirs",akses.getpropinsirs());
        param.put("kontakrs",akses.getkontakrs());
        param.put("emailrs",akses.getemailrs());
        param.put("logo",Sequel.cariGambar("select setting.logo from setting"));
        param.put("norawat",TNoRw.getText());
        String noRawatAman = TNoRw.getText().replaceAll("'","");
        String qry =
            "select "+
            "pasien.no_rkm_medis, pasien.nm_pasien, pasien.jk, pasien.tgl_lahir, "+
            "TIMESTAMPDIFF(YEAR, pasien.tgl_lahir, CURDATE()) as umur, "+
            "reg_periksa.tgl_registrasi, reg_periksa.jam_reg, "+
            "data_triase_igd.tgl_kunjungan, data_triase_igd.cara_masuk, data_triase_igd.alat_transportasi, "+
            "CASE WHEN data_triase_igd.alat_transportasi='AGD' THEN 'Ambulance' ELSE 'Kendaraan bukan ambulance' END as kendaraan_tampil, "+
            "data_triase_igd.alasan_kedatangan, data_triase_igd.keterangan_kedatangan, data_triase_igd.kode_kasus, "+
            "master_triase_macam_kasus.macam_kasus, "+
            "CASE WHEN data_triase_igd.kode_kasus='004' THEN 'Non Trauma' ELSE 'Trauma' END as kasus_tampil, "+
            "data_triase_igd.kontak_awal_tanggal, data_triase_igd.kontak_awal_pukul, "+
            "data_triase_igd.terpasang_infus, data_triase_igd.terpasang_ngt, data_triase_igd.terpasang_kateter_urin, "+
            "data_triase_igd.nama_pengantar, data_triase_igd.telp_pengantar, "+
            "data_triase_igd.tekanan_darah, data_triase_igd.nadi, data_triase_igd.pernapasan, data_triase_igd.suhu, "+
            "data_triase_igd.saturasi_o2, data_triase_igd.nyeri, data_triase_igd.kesadaran, "+
            "data_triase_igd.berat_badan, data_triase_igd.tinggi_badan, "+
            "data_triase_pacs.keluhan_utama, "+
            "data_triase_pacs.skor_kesadaran, data_triase_pacs.skor_tekanan_darah_sistolik, data_triase_pacs.skor_nadi, "+
            "data_triase_pacs.skor_respirasi, data_triase_pacs.skor_temperatur, data_triase_pacs.skor_saturasi_o2, "+
            "data_triase_pacs.total_skor, data_triase_pacs.level_pacs, data_triase_pacs.keputusan_pacs, "+
            "data_triase_pacs.keputusan_pukul, data_triase_pacs.tanggal_triase, "+
            "pegawai.nama as petugas_nama, "+
            "data_triase_mekanisme_trauma.kkl_tunggal, data_triase_mekanisme_trauma.kkl_dengan_lawan, data_triase_mekanisme_trauma.kkl_lawan, "+
            "data_triase_mekanisme_trauma.kkl_tempat_kejadian, data_triase_mekanisme_trauma.kkl_tanggal_kejadian, data_triase_mekanisme_trauma.kkl_pukul_kejadian, "+
            "data_triase_mekanisme_trauma.jatuh_ketinggian, data_triase_mekanisme_trauma.jatuh_ketinggian_keterangan, "+
            "data_triase_mekanisme_trauma.luka_bakar, data_triase_mekanisme_trauma.luka_bakar_keterangan, "+
            "data_triase_mekanisme_trauma.trauma_fisik, data_triase_mekanisme_trauma.trauma_fisik_keterangan, "+
            "data_triase_mekanisme_trauma.trauma_zat_kimia, data_triase_mekanisme_trauma.trauma_zat_kimia_keterangan, "+
            "data_triase_mekanisme_trauma.trauma_zat_lainnya, data_triase_mekanisme_trauma.trauma_zat_lainnya_keterangan "+
            "from data_triase_igd "+
            "inner join reg_periksa on reg_periksa.no_rawat = data_triase_igd.no_rawat "+
            "inner join pasien on pasien.no_rkm_medis = reg_periksa.no_rkm_medis "+
            "left join master_triase_macam_kasus on master_triase_macam_kasus.kode_kasus = data_triase_igd.kode_kasus "+
            "left join data_triase_pacs on data_triase_pacs.no_rawat = data_triase_igd.no_rawat "+
            "left join pegawai on pegawai.nik = data_triase_pacs.nik "+
            "left join data_triase_mekanisme_trauma on data_triase_mekanisme_trauma.no_rawat = data_triase_igd.no_rawat "+
            "where data_triase_igd.no_rawat='"+noRawatAman+"'";
        Valid.MyReportqry("rptLembarTriasePacs.jasper","report","::[ Triase PACS ]::",qry,param);
    }

    /**
     * nilai input -> tentukan kategori -> tentukan skor 0-3 -> tampilkan skor.
     * Dipanggil tiap kali salah satu tanda vital PACS selesai diisi (focusLost)
     * atau Kesadaran diganti. Semua aturan ambil dari kelas PacsScoring - tidak
     * ada angka/kategori yang ditentukan di sini, method ini cuma parsing input
     * mentah lalu menampilkan hasilnya ke combo skor (yang sudah dibuat
     * read-only di buatComboSkor()).
     * Nadi >=103 (di luar kategori formulir) sengaja TIDAK dihitung otomatis -
     * ditampilkan "?" + peringatan, sesuai keputusan yang sudah dikonfirmasi.
     */
    private void hitungSkorOtomatisPacs(){
        // Kesadaran
        Object kes = PacsKesadaran.getSelectedItem();
        CmbSkorKesadaranPacs.setSelectedItem(String.valueOf(PacsScoring.skorKesadaran(kes==null?null:kes.toString())));

        // Tekanan Darah Sistolik - PacsTensi diisi format "sistolik/diastolik" (mis. 120/80)
        try{
            String teks = PacsTensi.getText().trim();
            if(!teks.isEmpty()){
                String sistolikTeks = teks.contains("/") ? teks.substring(0,teks.indexOf("/")).trim() : teks;
                int sistolik = Integer.parseInt(sistolikTeks);
                CmbSkorTDPacs.setSelectedItem(String.valueOf(PacsScoring.skorTekananDarahSistolik(sistolik)));
            }
        }catch(NumberFormatException e){
            // format Tekanan Darah belum valid/belum lengkap - skor TD dibiarkan apa adanya
        }

        // Nadi
        try{
            String teks = PacsNadi.getText().trim();
            if(!teks.isEmpty()){
                int nadi = Integer.parseInt(teks);
                Integer skorNadi = PacsScoring.skorNadi(nadi);
                if(skorNadi==null){
                    CmbSkorNadiPacs.setSelectedItem("?");
                    JOptionPane.showMessageDialog(null,"Nadi "+nadi+"x/menit di luar kategori skor pada formulir (SKOR 0 = <=101, SKOR 1 = 102). Skor Nadi tidak dihitung otomatis - mohon periksa ulang input Nadi.");
                }else{
                    CmbSkorNadiPacs.setSelectedItem(String.valueOf(skorNadi));
                }
            }
        }catch(NumberFormatException e){
        }

        // Respirasi
        try{
            String teks = PacsRespirasi.getText().trim();
            if(!teks.isEmpty()){
                int respirasi = Integer.parseInt(teks);
                CmbSkorRespirasiPacs.setSelectedItem(String.valueOf(PacsScoring.skorRespirasi(respirasi)));
            }
        }catch(NumberFormatException e){
        }

        // Temperatur
        try{
            String teks = PacsSuhu.getText().trim().replace(",",".");
            if(!teks.isEmpty()){
                double suhu = Double.parseDouble(teks);
                CmbSkorTemperaturPacs.setSelectedItem(String.valueOf(PacsScoring.skorTemperatur(suhu)));
            }
        }catch(NumberFormatException e){
        }

        // Saturasi O2
        try{
            String teks = PacsSaturasi.getText().trim();
            if(!teks.isEmpty()){
                int saturasi = Integer.parseInt(teks);
                CmbSkorSaturasiPacs.setSelectedItem(String.valueOf(PacsScoring.skorSaturasiO2(saturasi)));
            }
        }catch(NumberFormatException e){
        }
    }

    /**
     * Stage g: jumlah otomatis 6 skor EWS -> total_skor (dihitung di Java,
     * bukan generated column DB, mengikuti pola project). Kalau salah satu
     * skor masih "?" (nilai input di luar kategori formulir, lihat
     * hitungSkorOtomatisPacs()), Total ikut ditampilkan "?" - tidak dijumlah
     * dengan asumsi 0, supaya tidak menyesatkan.
     */
    private void hitungTotalSkorPacs(){
        widget.ComboBox[] semuaSkor = {CmbSkorKesadaranPacs,CmbSkorTDPacs,CmbSkorNadiPacs,CmbSkorRespirasiPacs,CmbSkorTemperaturPacs,CmbSkorSaturasiPacs};
        int total = 0;
        for(widget.ComboBox cmb : semuaSkor){
            if(cmb.getSelectedItem()==null||"?".equals(cmb.getSelectedItem().toString())){
                LblTotalSkorPacs.setText("?");
                return;
            }
            total += Integer.parseInt(cmb.getSelectedItem().toString());
        }
        LblTotalSkorPacs.setText(String.valueOf(total));
    }

