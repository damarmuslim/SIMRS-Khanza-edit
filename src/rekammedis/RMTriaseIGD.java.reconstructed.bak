            Valid.pindah(evt,CaraMasuk,PrimerKeluhanUtama);
        }else if(TabTriase.getSelectedIndex()==1){
            Valid.pindah(evt,CaraMasuk,SekunderAnamnesa);
        }
    }//GEN-LAST:event_KeteranganKedatanganKeyPressed

