logs/
*.log
hs_err_pid*.log
replay_pid*.log

# Backup files
*.bak

# Backup metadata Git saat perapihan checkout. Hanya untuk pemulihan lokal.
.git-legacy-*/

# Local diagnostic outputs
hasil-cek-detail.txt
hasil-kategori.txt
medis-hal-*.png

# Screenshot hasil desain/render - jangan upload karena berpotensi memuat data pasien
design_handoff_simrs_rm_forms/screenshots/

# Claude local settings
.claude/settings.json
.claude/settings.local.json

# Editor and workspace settings
.vscode/
.claude/
.agents/
.cursor/

# Temporary / Root jar
/*.jar
